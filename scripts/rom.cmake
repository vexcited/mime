if(SYSTEM STREQUAL "Darwin")
    set(section ".section __TEXT,__const")
    set(prefix _)
else()
    set(section ".section .rodata.mime_rom,\"a\"")
    set(prefix)
endif()

# the files whose microsoft originals the host fetches, by their lower case path below the drive. an entry's place in
# the manifest is the index the host knows it by, see MimeRomEntry.genuine.
set(genuine_paths "")
set(genuine_sizes "")
if(MANIFEST AND EXISTS "${MANIFEST}")
    file(STRINGS ${MANIFEST} manifest_lines)
    foreach(line IN LISTS manifest_lines)
        if(line MATCHES "^([^\t#][^\t]*)\t[0-9a-f]+\t[0-9A-Fa-f]+\t([0-9]+)$")
            string(TOLOWER "windows/${CMAKE_MATCH_1}" key)
            list(APPEND genuine_paths "${key}")
            list(APPEND genuine_sizes "${CMAKE_MATCH_2}")
        elseif(NOT line MATCHES "^(#.*)?$")
            message(FATAL_ERROR "${MANIFEST}: not an entry: ${line}")
        endif()
    endforeach()
endif()
list(LENGTH genuine_paths genuine_count)
if(genuine_count GREATER 256)
    message(FATAL_ERROR "${MANIFEST} lists more files than MIME_GENUINE_MAX")
endif()
set(genuine_matched "")

list(LENGTH FILES count)
string(TIMESTAMP built "%s" UTC)
set(text "${section}\n.p2align 14\n.globl ${prefix}mime_rom\n${prefix}mime_rom:\n.quad 0x004D4F52454D494D\n.long ${count}, ${built}\n")
set(data "")
set(i 0)
foreach(file IN LISTS FILES)
    if(file MATCHES "/hives/")
        set(directory config)
    elseif(file MATCHES "/themes/aero/")
        set(directory Resources/Themes/aero)
    elseif(file MATCHES "/winroot/")
        set(directory .)
    elseif(file MATCHES "/winfonts/")
        set(directory Fonts)
    elseif(file MATCHES "/winmedia/")
        set(directory Media)
    elseif(file MATCHES "/wincolor/")
        set(directory System32/spool/drivers/color)
    elseif(file MATCHES "/windrivers/")
        set(directory System32/drivers)
    elseif(file MATCHES "/winwbem/")
        set(directory System32/wbem)
    elseif(file MATCHES "/syswow64wbem/")
        set(directory SysWOW64/wbem)
    elseif(file MATCHES "/sysx64/")
        set(directory SysX64)
    elseif(file MATCHES "/syswow64/")
        set(directory SysWOW64)
    else()
        set(directory System32)
    endif()
    get_filename_component(name ${file} NAME)
    set(path "\\Windows\\${directory}\\${name}")
    string(REPLACE "/" "\\" path "${path}")
    if(directory STREQUAL ".")
        set(path "\\Windows\\${name}")
    elseif(directory STREQUAL "config")
        set(path "\\Windows\\System32\\config\\${name}")
        if(name STREQUAL "NTUSER.DAT")
            set(path "\\Users\\Default\\NTUSER.DAT")
        endif()
    endif()
    string(REPLACE "/" "\\" path "${path}")
    string(LENGTH "${path}" length)
    math(EXPR padding "96 - ${length}")
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(REPLACE "\\" "/" key "${path}")
    string(SUBSTRING "${key}" 1 -1 key)
    string(TOLOWER "${key}" key)
    list(FIND genuine_paths "${key}" found)
    set(genuine 0)
    set(genuine_size 0)
    if(found GREATER -1)
        math(EXPR genuine "${found} + 1")
        list(GET genuine_sizes ${found} genuine_size)
        list(APPEND genuine_matched "${key}")
    endif()
    string(APPEND text ".ascii \"${escaped}\"\n.space ${padding}\n.quad data${i} - ${prefix}mime_rom, data${i}_end - data${i}, ${genuine_size}\n.long ${genuine}, 0\n")
    string(APPEND data ".p2align 12\ndata${i}: .incbin \"${file}\"\ndata${i}_end:\n")
    math(EXPR i "${i} + 1")
endforeach()
foreach(key IN LISTS genuine_paths)
    list(FIND genuine_matched "${key}" found)
    if(found EQUAL -1)
        message(WARNING "${MANIFEST}: mime has no file ${key}, the host fetches it for nothing")
    endif()
endforeach()
string(APPEND text "${data}.p2align 14\n.globl ${prefix}mime_rom_end\n${prefix}mime_rom_end:\n")
if(NOT SYSTEM STREQUAL "Darwin")
    # without the note, ld.bfd gives the whole host an executable stack.
    string(APPEND text ".section .note.GNU-stack,\"\",@progbits\n")
endif()
file(WRITE ${OUTPUT} "${text}")
