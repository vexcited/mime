if(SYSTEM STREQUAL "Darwin")
    set(section ".section __TEXT,__const")
    set(prefix _)
else()
    set(section ".section .rodata.mime_rom,\"a\"")
    set(prefix)
endif()

# the system files of windows that are microsoft's, in the case and the order of the manifest: the rom names each one
# with no bytes, and the host holds the only copy there is. an entry's place in the manifest is the index the host
# knows it by, see MimeRomEntry.genuine.
set(genuine_paths "")
set(genuine_keys "")
set(genuine_sizes "")
if(MANIFEST AND EXISTS "${MANIFEST}")
    file(STRINGS ${MANIFEST} manifest_lines)
    foreach(line IN LISTS manifest_lines)
        if(line MATCHES "^([^\t#][^\t]*)\t[0-9a-f]+\t(image:[0-9a-f]+|[0-9A-Fa-f]+)\t([0-9]+)$")
            string(TOLOWER "windows/${CMAKE_MATCH_1}" key)
            list(APPEND genuine_paths "${CMAKE_MATCH_1}")
            list(APPEND genuine_keys "${key}")
            list(APPEND genuine_sizes "${CMAKE_MATCH_3}")
        elseif(NOT line MATCHES "^(#.*)?$")
            message(FATAL_ERROR "${MANIFEST}: not an entry: ${line}")
        endif()
    endforeach()
endif()
list(LENGTH genuine_paths genuine_count)
if(genuine_count GREATER 1024)
    message(FATAL_ERROR "${MANIFEST} lists more files than MIME_GENUINE_MAX")
endif()

set(text "")
set(count 0)
function(rom_entry path offset size genuine_size genuine)
    string(LENGTH "${path}" length)
    if(length GREATER 95)
        message(FATAL_ERROR "the rom path ${path} is longer than MimeRomEntry.path")
    endif()
    math(EXPR padding "96 - ${length}")
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(APPEND text ".ascii \"${escaped}\"\n.space ${padding}\n.quad ${offset}, ${size}, ${genuine_size}\n.long ${genuine}, 0\n")
    math(EXPR count "${count} + 1")
    set(text "${text}" PARENT_SCOPE)
    set(count ${count} PARENT_SCOPE)
endfunction()

set(data "")
set(i 0)
foreach(file IN LISTS FILES)
    if(file MATCHES "/hives/")
        set(directory config)
    elseif(file MATCHES "/themes/aero/")
        set(directory Resources/Themes/aero)
    elseif(file MATCHES "/winroot/")
        set(directory .)
    elseif(file MATCHES "/winfonts/")
        set(directory Fonts)
    elseif(file MATCHES "/wincolor/")
        set(directory System32/spool/drivers/color)
    elseif(file MATCHES "/windrivers/")
        set(directory System32/drivers)
    elseif(file MATCHES "/winwbem/")
        set(directory System32/wbem)
    elseif(file MATCHES "/syswow64wbem/")
        set(directory SysWOW64/wbem)
    elseif(file MATCHES "/sysx64/")
        set(directory SysX64)
    elseif(file MATCHES "/syswow64/")
        set(directory SysWOW64)
    else()
        set(directory System32)
    endif()
    get_filename_component(name ${file} NAME)
    set(path "\\Windows\\${directory}\\${name}")
    string(REPLACE "/" "\\" path "${path}")
    if(directory STREQUAL ".")
        set(path "\\Windows\\${name}")
    elseif(directory STREQUAL "config")
        set(path "\\Windows\\System32\\config\\${name}")
        if(name STREQUAL "NTUSER.DAT")
            set(path "\\Users\\Default\\NTUSER.DAT")
        endif()
    endif()
    string(REPLACE "/" "\\" path "${path}")
    string(REPLACE "\\" "/" key "${path}")
    string(SUBSTRING "${key}" 1 -1 key)
    string(TOLOWER "${key}" key)
    string(REGEX REPLACE "^windows/sysx64/" "windows/system32/" key "${key}")
    if(key IN_LIST genuine_keys)
        message(FATAL_ERROR "${file}: ${MANIFEST} lists this file, the rom carries no bytes for it")
    endif()
    rom_entry("${path}" "data${i} - ${prefix}mime_rom" "data${i}_end - data${i}" 0 0)
    string(APPEND data ".p2align 12\ndata${i}: .incbin \"${file}\"\ndata${i}_end:\n")
    math(EXPR i "${i} + 1")
endforeach()
set(index 0)
foreach(path IN LISTS genuine_paths)
    list(GET genuine_sizes ${index} genuine_size)
    math(EXPR index "${index} + 1")
    string(REPLACE "/" "\\" path "${path}")
    rom_entry("\\Windows\\${path}" 0 0 ${genuine_size} ${index})
    # an x64 program on windows on arm loads the arm64x dll of System32, whose bytes are its identity.
    if(SYSX64 AND path MATCHES "^System32\\\\(.*)$")
        rom_entry("\\Windows\\SysX64\\${CMAKE_MATCH_1}" 0 0 ${genuine_size} ${index})
    endif()
endforeach()
string(TIMESTAMP built "%s" UTC)
set(text "${section}\n.p2align 14\n.globl ${prefix}mime_rom\n${prefix}mime_rom:\n.quad 0x004D4F52454D494D\n.long ${count}, ${built}\n${text}")
string(APPEND text "${data}.p2align 14\n.globl ${prefix}mime_rom_end\n${prefix}mime_rom_end:\n")
if(NOT SYSTEM STREQUAL "Darwin")
    # without the note, ld.bfd gives the whole host an executable stack.
    string(APPEND text ".section .note.GNU-stack,\"\",@progbits\n")
endif()
file(WRITE ${OUTPUT} "${text}")
