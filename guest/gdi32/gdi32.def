; uniscribe, which gdi32 exports as windows does, lives in usp10.
LIBRARY gdi32.dll
EXPORTS
    ScriptApplyDigitSubstitution=usp10.ScriptApplyDigitSubstitution
    ScriptApplyLogicalWidth=usp10.ScriptApplyLogicalWidth
    ScriptBreak=usp10.ScriptBreak
    ScriptCPtoX=usp10.ScriptCPtoX
    ScriptCacheGetHeight=usp10.ScriptCacheGetHeight
    ScriptFreeCache=usp10.ScriptFreeCache
    ScriptGetCMap=usp10.ScriptGetCMap
    ScriptGetFontAlternateGlyphs=usp10.ScriptGetFontAlternateGlyphs
    ScriptGetFontFeatureTags=usp10.ScriptGetFontFeatureTags
    ScriptGetFontLanguageTags=usp10.ScriptGetFontLanguageTags
    ScriptGetFontProperties=usp10.ScriptGetFontProperties
    ScriptGetFontScriptTags=usp10.ScriptGetFontScriptTags
    ScriptGetGlyphABCWidth=usp10.ScriptGetGlyphABCWidth
    ScriptGetLogicalWidths=usp10.ScriptGetLogicalWidths
    ScriptGetProperties=usp10.ScriptGetProperties
    ScriptIsComplex=usp10.ScriptIsComplex
    ScriptItemize=usp10.ScriptItemize
    ScriptItemizeOpenType=usp10.ScriptItemizeOpenType
    ScriptJustify=usp10.ScriptJustify
    ScriptLayout=usp10.ScriptLayout
    ScriptPlace=usp10.ScriptPlace
    ScriptPlaceOpenType=usp10.ScriptPlaceOpenType
    ScriptPositionSingleGlyph=usp10.ScriptPositionSingleGlyph
    ScriptRecordDigitSubstitution=usp10.ScriptRecordDigitSubstitution
    ScriptShape=usp10.ScriptShape
    ScriptShapeOpenType=usp10.ScriptShapeOpenType
    ScriptStringAnalyse=usp10.ScriptStringAnalyse
    ScriptStringCPtoX=usp10.ScriptStringCPtoX
    ScriptStringFree=usp10.ScriptStringFree
    ScriptStringGetLogicalWidths=usp10.ScriptStringGetLogicalWidths
    ScriptStringGetOrder=usp10.ScriptStringGetOrder
    ScriptStringOut=usp10.ScriptStringOut
    ScriptStringValidate=usp10.ScriptStringValidate
    ScriptStringXtoCP=usp10.ScriptStringXtoCP
    ScriptString_pLogAttr=usp10.ScriptString_pLogAttr
    ScriptString_pSize=usp10.ScriptString_pSize
    ScriptString_pcOutChars=usp10.ScriptString_pcOutChars
    ScriptSubstituteSingleGlyph=usp10.ScriptSubstituteSingleGlyph
    ScriptTextOut=usp10.ScriptTextOut
    ScriptXtoCP=usp10.ScriptXtoCP
    UspAllocCache=usp10.UspAllocCache
    UspAllocTemp=usp10.UspAllocTemp
    UspFreeMem=usp10.UspFreeMem
