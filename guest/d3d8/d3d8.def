; the exports of windows' d3d8.dll, with their ordinals. no 64-bit d3d8 exists to take them from.
LIBRARY d3d8.dll
EXPORTS
    Direct3D8EnableMaximizedWindowedModeShim=_Direct3D8EnableMaximizedWindowedModeShim@4 @1
    ValidatePixelShader=_ValidatePixelShader@16 @2
    ValidateVertexShader=_ValidateVertexShader@20 @3
    DebugSetMute=_DebugSetMute@0 @4
    Direct3DCreate8=_Direct3DCreate8@4 @5
