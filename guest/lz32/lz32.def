    LZCreateFileW=kernel32.LZCreateFileW @7
    LZDone=kernel32.LZDone @8
    LZInit=kernel32.LZInit @9
    LZOpenFileA=kernel32.LZOpenFileA @10
    LZOpenFileW=kernel32.LZOpenFileW @11
    LZRead=kernel32.LZRead @12
    LZSeek=kernel32.LZSeek @13
    LZStart=kernel32.LZStart @14
