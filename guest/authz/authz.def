; the exports of authz.dll of windows with their ordinals, less the ones that are not here yet.
LIBRARY authz.dll
EXPORTS
    AuthzInitializeResourceManager @21
    AuthzFreeResourceManager @11
    AuthzInitializeContextFromToken @16
    AuthzInitializeContextFromSid @15
    AuthzFreeContext @9
    AuthzFreeHandle @10
    AuthzAccessCheck @1
    AuthzGetInformationFromContext @12
    AuthzEnumerateSecurityEventSources @5
    AuthzInstallSecurityEventSource @23
    AuthzRegisterSecurityEventSource @29
    AuthzReportSecurityEvent @30
    AuthzReportSecurityEventFromParams @31
    AuthzUninstallSecurityEventSource @34
    AuthzUnregisterSecurityEventSource @36
