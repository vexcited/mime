; the exports of security.dll of windows, which secur32 answers.
LIBRARY security.dll
EXPORTS
    AcceptSecurityContext=SECUR32.AcceptSecurityContext @1
    AcquireCredentialsHandleA=SECUR32.AcquireCredentialsHandleA @2
    AcquireCredentialsHandleW=SECUR32.AcquireCredentialsHandleW @3
    AddSecurityPackageA=SECUR32.AddSecurityPackageA @4
    AddSecurityPackageW=SECUR32.AddSecurityPackageW @5
    ApplyControlToken=SECUR32.ApplyControlToken @6
    CompleteAuthToken=SECUR32.CompleteAuthToken @7
    DecryptMessage=SECUR32.DecryptMessage @8
    DeleteSecurityContext=SECUR32.DeleteSecurityContext @9
    DeleteSecurityPackageA=SECUR32.DeleteSecurityPackageA @10
    DeleteSecurityPackageW=SECUR32.DeleteSecurityPackageW @11
    EncryptMessage=SECUR32.EncryptMessage @12
    EnumerateSecurityPackagesA=SECUR32.EnumerateSecurityPackagesA @13
    EnumerateSecurityPackagesW=SECUR32.EnumerateSecurityPackagesW @14
    ExportSecurityContext=SECUR32.ExportSecurityContext @15
    FreeContextBuffer=SECUR32.FreeContextBuffer @16
    FreeCredentialsHandle=SECUR32.FreeCredentialsHandle @17
    ImpersonateSecurityContext=SECUR32.ImpersonateSecurityContext @18
    ImportSecurityContextA=SECUR32.ImportSecurityContextA @19
    ImportSecurityContextW=SECUR32.ImportSecurityContextW @20
    InitSecurityInterfaceA=SECUR32.InitSecurityInterfaceA @21
    InitSecurityInterfaceW=SECUR32.InitSecurityInterfaceW @22
    InitializeSecurityContextA=SECUR32.InitializeSecurityContextA @23
    InitializeSecurityContextW=SECUR32.InitializeSecurityContextW @24
    MakeSignature=SECUR32.MakeSignature @25
    QueryContextAttributesA=SECUR32.QueryContextAttributesA @26
    QueryContextAttributesW=SECUR32.QueryContextAttributesW @27
    QueryCredentialsAttributesA=SECUR32.QueryCredentialsAttributesA @28
    QueryCredentialsAttributesW=SECUR32.QueryCredentialsAttributesW @29
    QuerySecurityContextToken=SECUR32.QuerySecurityContextToken @30
    QuerySecurityPackageInfoA=SECUR32.QuerySecurityPackageInfoA @31
    QuerySecurityPackageInfoW=SECUR32.QuerySecurityPackageInfoW @32
    RevertSecurityContext=SECUR32.RevertSecurityContext @33
    SealMessage=SECUR32.EncryptMessage @34
    UnsealMessage=SECUR32.DecryptMessage @35
    VerifySignature=SECUR32.VerifySignature @36
