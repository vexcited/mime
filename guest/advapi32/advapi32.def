; the registry lives in kernelbase, which advapi32 forwards to like windows does.
LIBRARY advapi32.dll
EXPORTS
    RegCloseKey=kernelbase.RegCloseKey
    RegCreateKeyA=kernelbase.RegCreateKeyA
    RegCreateKeyExA=kernelbase.RegCreateKeyExA
    RegCreateKeyExW=kernelbase.RegCreateKeyExW
    RegCreateKeyW=kernelbase.RegCreateKeyW
    RegDeleteKeyA=kernelbase.RegDeleteKeyA
    RegDeleteKeyExA=kernelbase.RegDeleteKeyExA
    RegDeleteKeyExW=kernelbase.RegDeleteKeyExW
    RegDeleteKeyValueA=kernelbase.RegDeleteKeyValueA
    RegDeleteKeyValueW=kernelbase.RegDeleteKeyValueW
    RegDeleteKeyW=kernelbase.RegDeleteKeyW
    RegDeleteTreeA=kernelbase.RegDeleteTreeA
    RegDeleteTreeW=kernelbase.RegDeleteTreeW
    RegDeleteValueA=kernelbase.RegDeleteValueA
    RegDeleteValueW=kernelbase.RegDeleteValueW
    RegDisablePredefinedCacheEx=kernelbase.RegDisablePredefinedCacheEx
    RegEnumKeyA=kernelbase.RegEnumKeyA
    RegEnumKeyExA=kernelbase.RegEnumKeyExA
    RegEnumKeyExW=kernelbase.RegEnumKeyExW
    RegEnumKeyW=kernelbase.RegEnumKeyW
    RegEnumValueA=kernelbase.RegEnumValueA
    RegEnumValueW=kernelbase.RegEnumValueW
    RegFlushKey=kernelbase.RegFlushKey
    RegGetValueA=kernelbase.RegGetValueA
    RegGetValueW=kernelbase.RegGetValueW
    RegLoadKeyA=kernelbase.RegLoadKeyA
    RegLoadKeyW=kernelbase.RegLoadKeyW
    RegNotifyChangeKeyValue=kernelbase.RegNotifyChangeKeyValue
    RegOpenCurrentUser=kernelbase.RegOpenCurrentUser
    RegOpenKeyA=kernelbase.RegOpenKeyA
    RegOpenKeyExA=kernelbase.RegOpenKeyExA
    RegOpenKeyExW=kernelbase.RegOpenKeyExW
    RegOpenKeyW=kernelbase.RegOpenKeyW
    RegOverridePredefKey=kernelbase.RegOverridePredefKey
    RegQueryInfoKeyA=kernelbase.RegQueryInfoKeyA
    RegQueryInfoKeyW=kernelbase.RegQueryInfoKeyW
    RegQueryValueExA=kernelbase.RegQueryValueExA
    RegQueryValueExW=kernelbase.RegQueryValueExW
    RegSetKeyValueA=kernelbase.RegSetKeyValueA
    RegSetKeyValueW=kernelbase.RegSetKeyValueW
    RegSetValueExA=kernelbase.RegSetValueExA
    RegSetValueExW=kernelbase.RegSetValueExW
    RegUnLoadKeyA=kernelbase.RegUnLoadKeyA
    RegUnLoadKeyW=kernelbase.RegUnLoadKeyW
    ; processes started with a token, as kernelbase has them.
    DeriveCapabilitySidsFromName=kernelbase.DeriveCapabilitySidsFromName
    CreateProcessAsUserA=kernelbase.CreateProcessAsUserA
    CreateProcessAsUserW=kernelbase.CreateProcessAsUserW
; event tracing lives in ntdll.
    CreateTraceInstanceId=ntdll.EtwCreateTraceInstanceId
    EventActivityIdControl=ntdll.EtwEventActivityIdControl
    EventEnabled=ntdll.EtwEventEnabled
    EventProviderEnabled=ntdll.EtwEventProviderEnabled
    EventRegister=ntdll.EtwEventRegister
    EventSetInformation=ntdll.EtwEventSetInformation
    EventUnregister=ntdll.EtwEventUnregister
    EventWrite=ntdll.EtwEventWrite
    EventWriteEndScenario=ntdll.EtwEventWriteEndScenario
    EventWriteEx=ntdll.EtwEventWriteEx
    EventWriteStartScenario=ntdll.EtwEventWriteStartScenario
    EventWriteString=ntdll.EtwEventWriteString
    EventWriteTransfer=ntdll.EtwEventWriteTransfer
    GetTraceEnableFlags=ntdll.EtwGetTraceEnableFlags
    GetTraceEnableLevel=ntdll.EtwGetTraceEnableLevel
    GetTraceLoggerHandle=ntdll.EtwGetTraceLoggerHandle
    RegisterTraceGuidsA=ntdll.EtwRegisterTraceGuidsA
    RegisterTraceGuidsW=ntdll.EtwRegisterTraceGuidsW
    TraceEvent=ntdll.EtwLogTraceEvent
    TraceEventInstance=ntdll.EtwTraceEventInstance
    TraceMessage=ntdll.EtwTraceMessage
    TraceMessageVa=ntdll.EtwTraceMessageVa
    UnregisterTraceGuids=ntdll.EtwUnregisterTraceGuids
