; the exports of windows' msftedit.dll, with their ordinals.
LIBRARY msftedit.dll
EXPORTS
    IID_IRichEditOle @2 DATA
    IID_IRichEditOleCallback @3 DATA
    CreateTextServices @4
    IID_ITextServices @5 DATA
    IID_ITextHost @6 DATA
    IID_ITextHost2 @7 DATA
    DisableOleinitCheck @8
    RichEditANSIWndProc @9
    RichEdit10ANSIWndProc @10
    SetCustomTextOutHandlerEx @11
    DllGetVersion @12
    RichEditWndProc @13
    MathBuildUp @17
    MathBuildDown @18
    MathTranslate @19
    GetMathAlphanumericCode @21
    GetMathAlphanumeric @22
    IID_ITextDocument2 @24 DATA
    IID_ITextServices2 @25 DATA
    DllGetActivationFactory @26
    IID_IRicheditWindowlessAccessibility @32 DATA
    IID_IRicheditUiaOverrides @33 DATA
    ShutdownTextServices @35
    SetTextServicesDpiCalculationOverride @36
    IID_IRicheditUiaNotificationOverrides @37 DATA
