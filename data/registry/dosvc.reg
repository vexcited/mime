; delivery optimization: Mime's own dosvc.dll in svchost -k NetworkService, downloading over http only. The class is
; served by the service and its interfaces are marshaled by onecorecommonproxystub.dll, as on windows 11 26300.
[HKLM\SYSTEM\CurrentControlSet\Services\DoSvc]
"DependOnService"=multi:"RpcSs"
"Description"="Performs content delivery optimization tasks"
"DisplayName"="Delivery Optimization"
"ErrorControl"=dword:00000001
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,60,ea,00,00,01,00,00,00,60,ea,00,00,00,00,00,00,00,00,00,00
"ImagePath"=expand:"%SystemRoot%\\System32\\svchost.exe -k NetworkService -p"
"LaunchProtected"=dword:00000002
"ObjectName"="NT Authority\\NetworkService"
"ServiceSidType"=dword:00000001
"Start"=dword:00000002
"DelayedAutostart"=dword:00000001
"Type"=dword:00000010

[HKLM\SYSTEM\CurrentControlSet\Services\DoSvc\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\system32\\dosvc.dll"
"ServiceDllUnloadOnStop"=dword:00000001

