; the system hive: the control set the kernel links as CurrentControlSet, and the keys of Control that the service control
; manager, the environment, the code pages and the device classes read.

[HKLM\SYSTEM\Select]
"Current"=dword:00000001
"Default"=dword:00000001
"Failed"=dword:00000000
"LastKnownGood"=dword:00000001

; the services that want to be told before a shutdown, none of Mime's do.
[HKLM\SYSTEM\CurrentControlSet\Control]
"PreshutdownOrder"=multi:

; the groups services start in. services.exe starts the automatic services by this order.
[HKLM\SYSTEM\CurrentControlSet\Control\ServiceGroupOrder]
"List"=multi:"Base","Pointer Port","Keyboard Port","Pointer Class","Keyboard Class","Video Init","Video","Video Save","File System","Streams Drivers","NDIS Wrapper","COM Infrastructure","UIGroup","PlugPlay","NDIS","TDI","NetBIOSGroup","ShellSvcGroup","SchedulerGroup","SpoolerGroup","AudioGroup","SmartCardGroup","NetworkProvider","RemoteValidation","NetDDEGroup","Parallel arbitrator","Extended Base","PCI Configuration"

; the service control manager reads this key and takes its defaults for the values it does not find.
[HKLM\SYSTEM\CurrentControlSet\Control\SCMConfig]

; the environment every process starts from, with the processor variables the kernel adds at each boot.
[HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment]
"ComSpec"=expand:"%SystemRoot%\\system32\\cmd.exe"
"DriverData"="C:\\Windows\\System32\\Drivers\\DriverData"
"OS"="Windows_NT"
"Path"=expand:"%SystemRoot%\\system32;%SystemRoot%;%SystemRoot%\\System32\\Wbem"
"PATHEXT"=".COM;.EXE;.BAT;.CMD;.VBS;.VBE;.JS;.JSE;.WSF;.WSH;.MSC"
"TEMP"=expand:"%SystemRoot%\\TEMP"
"TMP"=expand:"%SystemRoot%\\TEMP"
"USERNAME"="SYSTEM"
"windir"=expand:"%SystemRoot%"

; the code pages of a machine in the United States, written again at each boot from the host's locale.
[HKLM\SYSTEM\CurrentControlSet\Control\Nls\CodePage]
"ACP"="1252"
"OEMCP"="437"

; chrome asks whether the machine is a convertible in slate mode, 1 is the laptop.
[HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl]
"ConvertibleSlateMode"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Control\DeviceClasses]

; the setup classes Windows defines for the devices Mime presents. setupapi and cfgmgr32 enumerate them and read the name.
