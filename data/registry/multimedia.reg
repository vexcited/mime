; multimedia drivers, read by winmm and msacm32. the media control interface has a driver for each device type and a type
; for each file extension, which winmm reads when a program opens a device or a file with mciSendString. the audio
; compression manager lists the codecs named msacm.* in Drivers32, in this order.
[HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Drivers32]
"msacm.imaadpcm"="imaadp32.acm"
"msacm.msadpcm"="msadp32.acm"
"msacm.msg711"="msg711.acm"
"msacm.msgsm610"="msgsm32.acm"
"msacm.l3acm"="l3codeca.acm"

[HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\MCI32]
"AVIVideo"="mciavi32.dll"
"CDAudio"="mcicda.dll"
"MPEGVideo"="mciqtz32.dll"
"Sequencer"="mciseq.dll"
"waveaudio"="mciwave.dll"

