; the default user, the template of every profile, and the settings of the system account. the kernel writes the locale of
; the user at each boot, see guest/ntos/cm/boot.c.

; the places of the user's folders, read by windows.storage and by every program that asks for a known folder, as the
; default user of the pinned image has them.
[HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders]
"AppData"=expand:"%USERPROFILE%\\AppData\\Roaming"
"Cache"=expand:"%USERPROFILE%\\AppData\\Local\\Microsoft\\Windows\\INetCache"
"Cookies"=expand:"%USERPROFILE%\\AppData\\Local\\Microsoft\\Windows\\INetCookies"
"Desktop"=expand:"%USERPROFILE%\\Desktop"
"Favorites"=expand:"%USERPROFILE%\\Favorites"
"History"=expand:"%USERPROFILE%\\AppData\\Local\\Microsoft\\Windows\\History"
"Local AppData"=expand:"%USERPROFILE%\\AppData\\Local"
"My Music"=expand:"%USERPROFILE%\\Music"
"My Pictures"=expand:"%USERPROFILE%\\Pictures"
"My Video"=expand:"%USERPROFILE%\\Videos"
"NetHood"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Network Shortcuts"
"Personal"=expand:"%USERPROFILE%\\Documents"
"PrintHood"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Printer Shortcuts"
"Programs"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs"
"Recent"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Recent"
"SendTo"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\SendTo"
"Start Menu"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu"
"Startup"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"
"Templates"=expand:"%USERPROFILE%\\AppData\\Roaming\\Microsoft\\Windows\\Templates"
"{374DE290-123F-4565-9164-39C4925E467B}"=expand:"%USERPROFILE%\\Downloads"

; the region of a machine in the United States, 244 is its geographic identifier. the language is written at each boot.
[HKCU\Control Panel\International\Geo]
"Name"="US"
"Nation"="244"

[HKU\.DEFAULT\Control Panel\International\Geo]
"Name"="US"
"Nation"="244"

; keys that programs open and that are empty on a new profile.
[HKCU\Control Panel\Accessibility]
[HKCU\Software\Microsoft\Accessibility]
[HKCU\Software\Microsoft\Windows\CurrentVersion\Internet Settings\Connections]
[HKCU\Software\Microsoft\Windows\DWM]

; chrome and the shell read whether windows are translucent.
[HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"EnableTransparency"=dword:00000001

; the folders for temporary files of the user and of the system account. every program that makes a temporary file reads them.
[HKCU\Environment]
"TEMP"=expand:"%USERPROFILE%\\AppData\\Local\\Temp"
"TMP"=expand:"%USERPROFILE%\\AppData\\Local\\Temp"

[HKU\.DEFAULT\Environment]
"TEMP"=expand:"%USERPROFILE%\\AppData\\Local\\Temp"
"TMP"=expand:"%USERPROFILE%\\AppData\\Local\\Temp"

; the printers of the user for programs that read them from win.ini: the default one, and each with its port. the only
; printer is the one winspool.dll has.
[HKCU\Software\Microsoft\Windows NT\CurrentVersion\Windows]
"Device"="Microsoft Print to PDF,winspool,PORTPROMPT:"

[HKCU\Software\Microsoft\Windows NT\CurrentVersion\Devices]
"Microsoft Print to PDF"="winspool,PORTPROMPT:"

[HKCU\Software\Microsoft\Windows NT\CurrentVersion\PrinterPorts]
"Microsoft Print to PDF"="winspool,PORTPROMPT:,15,45"
