; the default providers crypt32 asks to check revocation and trust list usage, as windows registers them.
[HKLM\SOFTWARE\Microsoft\Cryptography\OID\EncodingType 1\{CertDllVerifyRevocation,CertDllVerifyCTLUsage}\DEFAULT]
"Dll"=multi:"C:\\Windows\\System32\\cryptnet.dll"
[HKLM\SOFTWARE\WOW6432Node\Microsoft\Cryptography\OID\EncodingType 1\{CertDllVerifyRevocation,CertDllVerifyCTLUsage}\DEFAULT]
"Dll"=multi:"C:\\Windows\\SysWOW64\\cryptnet.dll"

; user account control is on. the kernel reads DeclineElevationPrompts here and finds none.
[HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableLUA"=dword:00000001

; the command interpreter reads this at its start.
[HKLM\SOFTWARE\Microsoft\Command Processor]
"EnableExtensions"=dword:00000001

; the contract of the Windows runtime that chrome checks for.
[HKLM\SOFTWARE\Microsoft\WindowsRuntime\WellKnownContracts]
"Windows.Foundation.UniversalApiContract"=dword:00130000

; the settings of the script hosts. The user keeps their own below HKCU, which the hosts create when //S saves them.
[HKLM\SOFTWARE\Microsoft\Windows Script Host\Settings]

