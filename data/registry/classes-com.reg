; the type libraries of the shell. Mime keeps the first in its own shell32.dll and the second, the part its shell windows
; use, in explorerframe.dll, where Windows has ieframe.dll.
[HKCR\TypeLib\{50A7E9B0-70EF-11D1-B75A-00A0C90564FE}\1.0\0\win32]
@="C:\\Windows\\SysWOW64\\shell32.dll"
