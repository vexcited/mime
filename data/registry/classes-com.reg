@="C:\\Windows\\System32\\shell32.dll"
[HKCR\TypeLib\{EAB22AC0-30C1-11CF-A7EB-0000C05BAE0B}\1.1\0\win32]
@="C:\\Windows\\SysWOW64\\explorerframe.dll"
[HKCR\TypeLib\{EAB22AC0-30C1-11CF-A7EB-0000C05BAE0B}\1.1\0\win64]
@="C:\\Windows\\System32\\explorerframe.dll"

; the shell windows are served by shell32 run by rundll32, as the interactive user, since Mime has no explorer.
