; the network list service: Mime's own netprofmsvc.dll in svchost -k netprofm. Its class is served by the service
; and its interfaces are marshaled by the genuine npmproxy.dll, as on windows 11 26100.
[HKLM\SYSTEM\CurrentControlSet\Services\netprofm]
"DependOnService"=multi:"NSI","RpcSs","TcpIp"
"Description"="@%SystemRoot%\\system32\\netprofmsvc.dll,-203"
"DisplayName"="@%SystemRoot%\\system32\\netprofmsvc.dll,-202"
"ErrorControl"=dword:00000001
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,e8,03,00,00,01,00,00,00,10,27,00,00,01,00,00,00,60,ea,00,00
"ImagePath"=expand:"%SystemRoot%\\System32\\svchost.exe -k netprofm -p"
"ObjectName"="NT AUTHORITY\\NetworkService"
"RequiredPrivileges"=multi:"SeImpersonatePrivilege","SeChangeNotifyPrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000003
"SvcMemHardLimitInMB"=dword:0000000a
"SvcMemMidLimitInMB"=dword:00000006
"SvcMemSoftLimitInMB"=dword:00000004
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\netprofm\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\netprofmsvc.dll"
"ServiceDllUnloadOnStop"=dword:00000001

[HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Svchost]
"netprofm"=multi:"netprofm"

[HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Svchost\netprofm]
"AuthenticationCapabilities"=dword:00002000
"CoInitializeSecurityAllowComCapability"=dword:00000001
"CoInitializeSecurityAllowCrossContainer"=dword:00000001
"CoInitializeSecurityAllowInteractiveUsers"=dword:00000001
"CoInitializeSecurityAllowLowBox"=dword:00000001
"CoInitializeSecurityParam"=dword:00000001
"COM_RoSettings"=dword:00000318
"COM_UnmarshalingPolicy"=dword:00000001
"RedirectionTrustPolicy"=dword:00000001

