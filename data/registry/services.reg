; the smart card resource manager as windows 11 registers it. it starts when a reader arrives, and mime has no reader
; and no library for it: winscard.dll answers SCARD_E_NO_SERVICE while it is stopped, as on a windows machine without a reader.
[HKLM\SYSTEM\CurrentControlSet\Services\SCardSvr]
"Description"="Manages access to smart cards read by this computer. If this service is stopped, this computer will be unable to read smart cards. If this service is disabled, any services that explicitly depend on it will fail to start."
"DisplayName"="Smart Card"
"ErrorControl"=dword:00000001
"FailureActions"=hex:84,03,00,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,c0,d4,01,00,01,00,00,00,e0,93,04,00,00,00,00,00,00,00,00,00
"Group"="SmartCardGroup"
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k LocalServiceAndNoImpersonation"
"ObjectName"="NT AUTHORITY\\LocalService"
"RequiredPrivileges"=multi:"SeCreateGlobalPrivilege","SeChangeNotifyPrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000003
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\SCardSvr\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\SCardSvr.dll"
"ServiceDllUnloadOnStop"=dword:00000001
"ServiceMain"="CalaisMain"

