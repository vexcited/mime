; the microsoft passport service, mime's own ngcsvc.dll in svchost -k LocalSystemNetworkRestricted, as windows 11
; registers it: started when a client asks the endpoint mapper for one of its rpc interfaces. mime serves the first, the
; key storage interface of the passport key storage provider.
[HKLM\SYSTEM\CurrentControlSet\Services\NgcSvc]
"DependOnService"=multi:"RpcSs"
"Description"="Provides process isolation for cryptographic keys used to authenticate to a user's associated identity providers. If this service is disabled, all uses and management of these keys will not be available, which includes machine logon and single-sign on for apps and websites. This service starts and stops automatically. It is recommended that you do not reconfigure this service."
"DisplayName"="Microsoft Passport"
"ErrorControl"=dword:00000001
"FailureActions"=hex:84,03,00,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,e8,03,00,00,01,00,00,00,10,27,00,00,00,00,00,00,00,00,00,00
"Group"="Cryptography"
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k LocalSystemNetworkRestricted -p"
"ObjectName"="LocalSystem"
"RequiredPrivileges"=multi:"SeImpersonatePrivilege","SeTcbPrivilege","SeTakeOwnershipPrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000003
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\NgcSvc\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\system32\\ngcsvc.dll"
"ServiceDllUnloadOnStop"=dword:00000001
"ServiceMain"="NgcServiceMain"

