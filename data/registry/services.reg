; the services Mime runs, as the service control manager reads them, and the keys of the Windows services that programs
; were seen to check. svchost hosts the four in the groups named in machine.reg, each from its own library.

[HKLM\SYSTEM\CurrentControlSet\Services\DcomLaunch]
"DisplayName"="DCOM Server Process Launcher"
"ErrorControl"=dword:00000001
"Group"="COM Infrastructure"
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k DcomLaunch -p"
"ObjectName"="LocalSystem"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\DcomLaunch\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\rpcss.dll"

[HKLM\SYSTEM\CurrentControlSet\Services\RpcEptMapper]
"DisplayName"="RPC Endpoint Mapper"
"ErrorControl"=dword:00000001
"Group"="COM Infrastructure"
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k RPCSS -p"
"ObjectName"="NT AUTHORITY\\NetworkService"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\RpcEptMapper\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\RpcEpMap.dll"

[HKLM\SYSTEM\CurrentControlSet\Services\RpcSs]
"DependOnService"=multi:"RpcEptMapper","DcomLaunch"
"DisplayName"="Remote Procedure Call (RPC)"
"ErrorControl"=dword:00000001
"Group"="COM Infrastructure"
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k RPCSS -p"
"ObjectName"="NT AUTHORITY\\NetworkService"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\RpcSs\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\rpcss.dll"

[HKLM\SYSTEM\CurrentControlSet\Services\CoreMessagingRegistrar]
"DisplayName"="CoreMessaging"
"ErrorControl"=dword:00000001
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k LocalServiceNoNetwork -p"
"ObjectName"="NT AUTHORITY\\LocalService"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\CoreMessagingRegistrar\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\CoreMessaging.dll"

; the dns client. the sechost test opens it as a service of the installation and finds it stopped, chrome reads its parameters
; and those of the network stack, whose domain is empty on a machine outside a domain.
[HKLM\SYSTEM\CurrentControlSet\Services\Dnscache]
"DisplayName"="DNS Client"
"ErrorControl"=dword:00000001
"ImagePath"=expand:"%SystemRoot%\\system32\\svchost.exe -k NetworkService -p"
"ObjectName"="NT AUTHORITY\\NetworkService"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\Dnscache\Parameters\{DnsConnections,DnsConnectionsProxies,DnsPolicyConfig}]

; the drivers of the network stack. the host does the work of both, and their driver objects tell the service control
; manager that they run, which is what a service that depends on them checks. the system and boot start drivers are
; never started by the manager, as on Windows.
[HKLM\SYSTEM\CurrentControlSet\Services\AFD]
"BootFlags"=dword:00000001
"Description"="@%systemroot%\\system32\\drivers\\afd.sys,-1000"
"DisplayName"="@%systemroot%\\system32\\drivers\\afd.sys,-1000"
"ErrorControl"=dword:00000001
"Group"="PNP_TDI"
"ImagePath"=expand:"\\SystemRoot\\system32\\drivers\\afd.sys"
"Start"=dword:00000001
"Type"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Services\Tcpip]
"BootFlags"=dword:00000001
"Description"="@%SystemRoot%\\system32\\tcpipcfg.dll,-50003"
"DisplayName"="@%SystemRoot%\\system32\\drivers\\tcpip.sys,-10001"
"ErrorControl"=dword:00000001
"Group"="PNP_TDI"
"ImagePath"=expand:"System32\\drivers\\tcpip.sys"
"Start"=dword:00000000
"Tag"=dword:00000003
"Type"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"Domain"=""

[HKLM\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters]

; the workstation service, which netapi32 asks for the computer's name, workgroup and users, and what it needs to run. nsi and
; the redirector drivers are windows' own keys. the host does the work of the drivers, their objects tell the service
; control manager that they run, and the manager never starts the system start ones.

[HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation]
"DependOnService"=multi:"MRxSmb20","NSI","Bowser"
"Description"="@%systemroot%\\system32\\wkssvc.dll,-101"
"DisplayName"="@%systemroot%\\system32\\wkssvc.dll,-100"
"ErrorControl"=dword:00000001
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,60,ea,00,00,01,00,00,00,c0,d4,01,00,00,00,00,00,00,00,00,00
"Group"="NetworkProvider"
"ImagePath"=expand:"%SystemRoot%\\System32\\svchost.exe -k NetworkService -p"
"ObjectName"="NT AUTHORITY\\NetworkService"
"RequiredPrivileges"=multi:"SeChangeNotifyPrivilege","SeImpersonatePrivilege","SeAuditPrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\NetworkProvider]
"DeviceName"="\\Device\\LanmanRedirector"
"DisplayName"=expand:"@%systemroot%\\system32\\wkssvc.dll,-102"
"Name"="Microsoft Windows Network"
"ProviderPath"=expand:"%SystemRoot%\\System32\\ntlanman.dll"

[HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters]
"EnablePlainTextPassword"=dword:00000000
"EnableSecuritySignature"=dword:00000001
"ServiceDll"=expand:"%SystemRoot%\\System32\\wkssvc.dll"
"ServiceDllUnloadOnStop"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Services\NSI]
"DependOnService"=multi:"rpcss","nsiproxy"
"Description"="@%SystemRoot%\\system32\\nsisvc.dll,-201"
"DisplayName"="@%SystemRoot%\\system32\\nsisvc.dll,-200"
"ErrorControl"=dword:00000001
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,c0,d4,01,00,01,00,00,00,e0,93,04,00,00,00,00,00,00,00,00,00
"ImagePath"=expand:"%systemroot%\\system32\\svchost.exe -k LocalService -p"
"ObjectName"="NT Authority\\LocalService"
"RequiredPrivileges"=multi:"SeCreateGlobalPrivilege","SeImpersonatePrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000002
"SvcMemHardLimitInMB"=dword:0000000a
"SvcMemMidLimitInMB"=dword:00000006
"SvcMemSoftLimitInMB"=dword:00000004
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\NSI\Parameters]
"ServiceDll"=expand:"%systemroot%\\system32\\nsisvc.dll"
"ServiceDllUnloadOnStop"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Services\nsiproxy]
"Description"="@%SystemRoot%\\system32\\drivers\\nsiproxy.sys,-1"
"DisplayName"="@%SystemRoot%\\system32\\drivers\\nsiproxy.sys,-2"
"ErrorControl"=dword:00000001
"ImagePath"=expand:"system32\\drivers\\nsiproxy.sys"
"Start"=dword:00000001
"Type"=dword:00000001

