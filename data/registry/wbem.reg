[HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Svchost]
"netsvcs"=multi:"Winmgmt","KeyIso"

[HKLM\SYSTEM\CurrentControlSet\Services\Winmgmt]
"DependOnService"=multi:"RPCSS"
"Description"="Provides a common interface and object model to access management information about operating system, devices, applications and services."
"DisplayName"="Windows Management Instrumentation"
"ErrorControl"=dword:00000000
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,60,ea,00,00,01,00,00,00,c0,d4,01,00,00,00,00,00,00,00,00,00
"ImagePath"=expand:"%systemroot%\\system32\\svchost.exe -k netsvcs -p"
"ObjectName"="LocalSystem"
"Start"=dword:00000002
"Type"=dword:00000020

[HKLM\SYSTEM\CurrentControlSet\Services\Winmgmt\Parameters]
