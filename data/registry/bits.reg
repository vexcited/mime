; background intelligent transfer: Mime's own qmgr.dll in netsvcs, downloading and uploading over http. Its classes
; are served by the service and its interfaces are marshaled by the genuine BitsProxy.dll, as on windows 11 26300.
[HKLM\SYSTEM\CurrentControlSet\Services\BITS]
"DependOnService"=multi:"RpcSs"
"Description"="@%SystemRoot%\\system32\\qmgr.dll,-1001"
"DisplayName"="@%SystemRoot%\\system32\\qmgr.dll,-1000"
"ErrorControl"=dword:00000001
"FailureActions"=hex:80,51,01,00,00,00,00,00,00,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,60,ea,00,00,01,00,00,00,c0,d4,01,00,00,00,00,00,00,00,00,00
"ImagePath"=expand:"%SystemRoot%\\System32\\svchost.exe -k netsvcs -p"
"ObjectName"="LocalSystem"
"RequiredPrivileges"=multi:"SeCreateGlobalPrivilege","SeImpersonatePrivilege","SeTcbPrivilege","SeAssignPrimaryTokenPrivilege","SeIncreaseQuotaPrivilege","SeDebugPrivilege"
"ServiceSidType"=dword:00000001
"Start"=dword:00000003
"Type"=dword:00000020
"DelayedAutostart"=dword:00000001

[HKLM\SYSTEM\CurrentControlSet\Services\BITS\Parameters]
"ServiceDll"=expand:"%SystemRoot%\\System32\\qmgr.dll"
"ServiceDllUnloadOnStop"=dword:00000001

