if(SYSTEM STREQUAL "Darwin")
    set(section ".section __TEXT,__const")
    set(prefix _)
else()
    set(section ".section .rodata.mime_rom,\"a\"")
    set(prefix)
endif()
list(LENGTH FILES count)
string(TIMESTAMP built "%s" UTC)
set(text "${section}\n.p2align 14\n.globl ${prefix}mime_rom\n${prefix}mime_rom:\n.quad 0x004D4F52454D494D\n.long ${count}, ${built}\n")
set(data "")
set(i 0)
foreach(file IN LISTS FILES)
    if(file MATCHES "/hives/")
        set(directory config)
    elseif(file MATCHES "/themes/aero/")
        set(directory Resources/Themes/aero)
    elseif(file MATCHES "/winroot/")
        set(directory .)
    elseif(file MATCHES "/winfonts/")
        set(directory Fonts)
    elseif(file MATCHES "/winmedia/")
        set(directory Media)
    elseif(file MATCHES "/windrivers/")
        set(directory System32/drivers)
    elseif(file MATCHES "/winwbem/")
        set(directory System32/wbem)
    elseif(file MATCHES "/syswow64wbem/")
        set(directory SysWOW64/wbem)
    elseif(file MATCHES "/sysx64/")
        set(directory SysX64)
    elseif(file MATCHES "/syswow64/")
        set(directory SysWOW64)
    else()
        set(directory System32)
    endif()
    get_filename_component(name ${file} NAME)
    set(path "\\Windows\\${directory}\\${name}")
    string(REPLACE "/" "\\" path "${path}")
    if(directory STREQUAL ".")
        set(path "\\Windows\\${name}")
    elseif(directory STREQUAL "config")
        set(path "\\Windows\\System32\\config\\${name}")
        if(name STREQUAL "NTUSER.DAT")
            set(path "\\Users\\Default\\NTUSER.DAT")
        endif()
    endif()
    string(REPLACE "/" "\\" path "${path}")
    string(LENGTH "${path}" length)
    math(EXPR padding "64 - ${length}")
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(APPEND text ".ascii \"${escaped}\"\n.space ${padding}\n.quad data${i} - ${prefix}mime_rom, data${i}_end - data${i}\n")
    string(APPEND data ".p2align 12\ndata${i}: .incbin \"${file}\"\ndata${i}_end:\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND text "${data}.p2align 14\n.globl ${prefix}mime_rom_end\n${prefix}mime_rom_end:\n")
file(WRITE ${OUTPUT} "${text}")
