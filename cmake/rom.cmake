# writes the assembly that embeds FILES into mime, see MimeRomHeader. files land in System32, or in SysX64 and SysWOW64
# for those under sysx64/ and syswow64/, page aligned so the guest maps them in place.
# mach-o symbols take a leading underscore, elf ones do not.
if(SYSTEM STREQUAL "Darwin")
    set(section ".section __TEXT,__const")
    set(prefix _)
else()
    set(section ".section .rodata.mime_rom,\"a\"")
    set(prefix)
endif()
list(LENGTH FILES count)
set(text "${section}\n.p2align 14\n.globl ${prefix}mime_rom\n${prefix}mime_rom:\n.quad 0x004D4F52454D494D\n.long ${count}, 0\n")
set(data "")
set(i 0)
foreach(file IN LISTS FILES)
    if(file MATCHES "/sysx64/")
        set(directory SysX64)
    elseif(file MATCHES "/syswow64/")
        set(directory SysWOW64)
    else()
        set(directory System32)
    endif()
    get_filename_component(name ${file} NAME)
    set(path "\\Windows\\${directory}\\${name}")
    string(LENGTH "${path}" length)
    math(EXPR padding "48 - ${length}")
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(APPEND text ".ascii \"${escaped}\"\n.space ${padding}\n.quad data${i} - ${prefix}mime_rom, data${i}_end - data${i}\n")
    string(APPEND data ".p2align 12\ndata${i}: .incbin \"${file}\"\ndata${i}_end:\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND text "${data}.p2align 14\n.globl ${prefix}mime_rom_end\n${prefix}mime_rom_end:\n")
file(WRITE ${OUTPUT} "${text}")
