# A rasterizer of the SVG that Mime's icons and cursors are drawn in: rect, circle, ellipse, line, polyline, polygon
# and path, groups with transforms and opacity, solid and linear gradient paints, strokes with round, miter and bevel
# joins and butt, round and square caps. Coordinates are fixed point, 1/65536 of a unit, angles and trigonometry use
# 1/2^30 inside. A pixel row is sampled on several lines with exact horizontal coverage, by the nonzero rule.
include_guard(GLOBAL)

set(_RS_ONE 65536)
set(_RS_ONE30 1073741824)

# A decimal as a 1/65536 fixed point integer.
function(_rs_num out text)
    if(NOT text MATCHES "^([-+]?)0*([0-9]*)(\\.([0-9]*))?([eE]([-+]?[0-9]+))?$")
        message(FATAL_ERROR "svg: bad number '${text}'")
    endif()
    set(sign "${CMAKE_MATCH_1}")
    set(int "${CMAKE_MATCH_2}")
    string(SUBSTRING "${CMAKE_MATCH_4}000000" 0 6 frac)
    set(exp "${CMAKE_MATCH_6}")
    string(REGEX REPLACE "^0+" "" frac "${frac}")
    if(int STREQUAL "")
        set(int 0)
    endif()
    if(frac STREQUAL "")
        set(frac 0)
    endif()
    math(EXPR v "${int} * 1000000 + ${frac}")
    if(exp)
        if(exp LESS 0)
            math(EXPR n "-(${exp})")
            foreach(i RANGE 1 ${n})
                math(EXPR v "${v} / 10")
            endforeach()
        else()
            foreach(i RANGE 1 ${exp})
                math(EXPR v "${v} * 10")
            endforeach()
        endif()
    endif()
    math(EXPR v "(${v} * 65536 + 500000) / 1000000")
    if(sign STREQUAL "-")
        math(EXPR v "-${v}")
    endif()
    set(${out} ${v} PARENT_SCOPE)
endfunction()

macro(_rs_abs var value)
    if(${value} LESS 0)
        math(EXPR ${var} "-(${value})")
    else()
        set(${var} ${value})
    endif()
endmacro()

function(_rs_isqrt out n)
    math(EXPR n "${n}")
    if(n LESS 2)
        if(n LESS 0)
            set(n 0)
        endif()
        set(${out} ${n} PARENT_SCOPE)
        return()
    endif()
    math(EXPR h "${n}" OUTPUT_FORMAT HEXADECIMAL)
    string(LENGTH "${h}" bits)
    math(EXPR x "1 << (((${bits} - 2) * 4 + 1) / 2)")
    while(TRUE)
        math(EXPR y "(${x} + ${n} / ${x}) / 2")
        if(y GREATER_EQUAL x)
            break()
        endif()
        set(x ${y})
    endwhile()
    set(${out} ${x} PARENT_SCOPE)
endfunction()

# sin and cos, 1/65536, of an angle in degrees, 1/65536.
function(_rs_sincos sin_out cos_out degrees)
    foreach(which sin cos)
        if(which STREQUAL "cos")
            math(EXPR d "${degrees} + 90 * 65536")
        else()
            set(d ${degrees})
        endif()
        math(EXPR d "((${d} % 23592960) + 23592960) % 23592960")
        if(d GREATER 11796480)
            math(EXPR d "${d} - 23592960")
        endif()
        if(d GREATER 5898240)
            math(EXPR d "11796480 - ${d}")
        elseif(d LESS -5898240)
            math(EXPR d "-11796480 - ${d}")
        endif()
        math(EXPR x "${d} * 18740330 >> 16")
        math(EXPR x2 "${x} * ${x} >> 30")
        math(EXPR v "(${x} * (1073741824 - ((${x2} / 6) * (1073741824 - ((${x2} / 20) * (1073741824 - ((${x2} / 42) * (1073741824 - ((${x2} / 72) * (1073741824 - ${x2} / 110) >> 30)) >> 30)) >> 30)) >> 30)) >> 30) >> 14")
        set(${which} ${v})
    endforeach()
    set(${sin_out} ${sin} PARENT_SCOPE)
    set(${cos_out} ${cos} PARENT_SCOPE)
endfunction()

# The angle of a vector in degrees, 1/65536.
function(_rs_atan2 out y x)
    if(x EQUAL 0 AND y EQUAL 0)
        set(${out} 0 PARENT_SCOPE)
        return()
    endif()
    _rs_abs(ax ${x})
    _rs_abs(ay ${y})
    if(ay LESS_EQUAL ax)
        math(EXPR t "(${ay} << 30) / ${ax}")
    else()
        math(EXPR t "(${ax} << 30) / ${ay}")
    endif()
    math(EXPR sq "(1 << 60) + ${t} * ${t}")
    _rs_isqrt(s ${sq})
    math(EXPR u "(${t} << 30) / (1073741824 + ${s})")
    math(EXPR u2 "${u} * ${u} >> 30")
    set(p 71582788)
    foreach(k 13 11 9 7 5 3 1)
        math(EXPR p "1073741824 / ${k} - (${u2} * ${p} >> 30)")
    endforeach()
    math(EXPR a "2 * (${u} * ${p} >> 30)")
    if(ay GREATER ax)
        math(EXPR a "1686629713 - ${a}")
    endif()
    if(x LESS 0)
        math(EXPR a "3373259426 - ${a}")
    endif()
    if(y LESS 0)
        math(EXPR a "-${a}")
    endif()
    math(EXPR a "${a} * 3754936 >> 30")
    set(${out} ${a} PARENT_SCOPE)
endfunction()

# Matrices are a;b;c;d;e;f, x' = a x + c y + e.
function(_rs_mul out m1 m2)
    list(GET m1 0 a1)
    list(GET m1 1 b1)
    list(GET m1 2 c1)
    list(GET m1 3 d1)
    list(GET m1 4 e1)
    list(GET m1 5 f1)
    list(GET m2 0 a2)
    list(GET m2 1 b2)
    list(GET m2 2 c2)
    list(GET m2 3 d2)
    list(GET m2 4 e2)
    list(GET m2 5 f2)
    math(EXPR a "(${a1} * ${a2} + ${c1} * ${b2}) >> 16")
    math(EXPR b "(${b1} * ${a2} + ${d1} * ${b2}) >> 16")
    math(EXPR c "(${a1} * ${c2} + ${c1} * ${d2}) >> 16")
    math(EXPR d "(${b1} * ${c2} + ${d1} * ${d2}) >> 16")
    math(EXPR e "((${a1} * ${e2} + ${c1} * ${f2}) >> 16) + ${e1}")
    math(EXPR f "((${b1} * ${e2} + ${d1} * ${f2}) >> 16) + ${f1}")
    set(${out} "${a};${b};${c};${d};${e};${f}" PARENT_SCOPE)
endfunction()

function(_rs_transform out m text)
    string(REGEX MATCHALL "[a-zA-Z]+[ ]*\\([^)]*\\)" items "${text}")
    foreach(item IN LISTS items)
        string(REGEX MATCH "^([a-zA-Z]+)[ ]*\\(([^)]*)\\)" _ "${item}")
        set(kind "${CMAKE_MATCH_1}")
        string(REGEX MATCHALL "[-+]?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?" texts "${CMAKE_MATCH_2}")
        set(args)
        foreach(t IN LISTS texts)
            _rs_num(v "${t}")
            list(APPEND args ${v})
        endforeach()
        list(LENGTH args n)
        if(kind STREQUAL "translate")
            list(GET args 0 tx)
            set(ty 0)
            if(n GREATER 1)
                list(GET args 1 ty)
            endif()
            set(t "65536;0;0;65536;${tx};${ty}")
        elseif(kind STREQUAL "scale")
            list(GET args 0 sx)
            set(sy ${sx})
            if(n GREATER 1)
                list(GET args 1 sy)
            endif()
            set(t "${sx};0;0;${sy};0;0")
        elseif(kind STREQUAL "rotate")
            list(GET args 0 angle)
            _rs_sincos(s c ${angle})
            math(EXPR ns "-${s}")
            set(t "${c};${s};${ns};${c};0;0")
            if(n GREATER 2)
                list(GET args 1 cx)
                list(GET args 2 cy)
                math(EXPR ncx "-${cx}")
                math(EXPR ncy "-${cy}")
                _rs_mul(t "65536;0;0;65536;${cx};${cy}" "${t}")
                _rs_mul(t "${t}" "65536;0;0;65536;${ncx};${ncy}")
            endif()
        elseif(kind STREQUAL "matrix")
            set(t "${args}")
        elseif(kind STREQUAL "skewX" OR kind STREQUAL "skewY")
            list(GET args 0 angle)
            _rs_sincos(s c ${angle})
            math(EXPR k "${s} * 65536 / ${c}")
            if(kind STREQUAL "skewX")
                set(t "65536;0;${k};65536;0;0")
            else()
                set(t "65536;${k};0;65536;0;0")
            endif()
        else()
            message(FATAL_ERROR "svg: transform ${kind}")
        endif()
        _rs_mul(m "${m}" "${t}")
    endforeach()
    set(${out} "${m}" PARENT_SCOPE)
endfunction()

# A paint: none, or "solid;r;g;b;a", or "url;id".
function(_rs_paint out text)
    string(STRIP "${text}" text)
    string(TOLOWER "${text}" text)
    if(text STREQUAL "none" OR text STREQUAL "transparent")
        set(${out} "none" PARENT_SCOPE)
        return()
    endif()
    if(text MATCHES "^url\\(#([^)]*)\\)")
        set(${out} "url;${CMAKE_MATCH_1}" PARENT_SCOPE)
        return()
    endif()
    if(text STREQUAL "black")
        set(text "#000000")
    elseif(text STREQUAL "white")
        set(text "#ffffff")
    endif()
    if(text MATCHES "^#([0-9a-f])([0-9a-f])([0-9a-f])$")
        set(text "#${CMAKE_MATCH_1}${CMAKE_MATCH_1}${CMAKE_MATCH_2}${CMAKE_MATCH_2}${CMAKE_MATCH_3}${CMAKE_MATCH_3}")
    endif()
    if(text MATCHES "^#([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])?$")
        set(alpha ff)
        if(CMAKE_MATCH_4)
            set(alpha ${CMAKE_MATCH_4})
        endif()
        math(EXPR r "0x${CMAKE_MATCH_1}")
        math(EXPR g "0x${CMAKE_MATCH_2}")
        math(EXPR b "0x${CMAKE_MATCH_3}")
        math(EXPR a "0x${alpha}")
        set(${out} "solid;${r};${g};${b};${a}" PARENT_SCOPE)
        return()
    endif()
    message(FATAL_ERROR "svg: paint '${text}'")
endfunction()

# The value of an attribute of a tag, or the default.
macro(_rs_attr var tag name default)
    if("${tag}" MATCHES "[ \t\n]${name}=\"([^\"]*)\"")
        set(${var} "${CMAKE_MATCH_1}")
    else()
        set(${var} "${default}")
    endif()
endmacro()

macro(_rs_attr_num var tag name default)
    _rs_attr(_rs_text "${tag}" ${name} "")
    if(_rs_text STREQUAL "")
        set(${var} ${default})
    else()
        _rs_num(${var} "${_rs_text}")
    endif()
endmacro()

# ------------------------------------------------------------------ geometry
# A subpath is in _rs_sp_<k> as x;y;x;y..., closed when _rs_spc_<k> is 1, in user space. _rs_spn counts them.

macro(_rs_sp_begin x y)
    math(EXPR _rs_spn "${_rs_spn} + 1")
    set(_rs_sp_${_rs_spn} "${x};${y}")
    set(_rs_spc_${_rs_spn} 0)
endmacro()

macro(_rs_sp_add x y)
    list(APPEND _rs_sp_${_rs_spn} ${x} ${y})
endmacro()

# The number of pieces a curve whose control polygon is that long in user units is cut into on the device.
macro(_rs_pieces var length)
    math(EXPR ${var} "(${length} * ${_rs_dscale} >> 48) / 3 + 2")
    if(${var} GREATER 64)
        set(${var} 64)
    endif()
endmacro()

function(_rs_dist out x0 y0 x1 y1)
    math(EXPR dx "(${x1} - ${x0}) >> 4")
    math(EXPR dy "(${y1} - ${y0}) >> 4")
    math(EXPR s "${dx} * ${dx} + ${dy} * ${dy}")
    _rs_isqrt(r ${s})
    math(EXPR r "${r} << 4")
    set(${out} ${r} PARENT_SCOPE)
endfunction()

macro(_rs_quad x0 y0 x1 y1 x2 y2)
    _rs_dist(_rs_l1 ${x0} ${y0} ${x1} ${y1})
    _rs_dist(_rs_l2 ${x1} ${y1} ${x2} ${y2})
    math(EXPR _rs_l "${_rs_l1} + ${_rs_l2}")
    _rs_pieces(_rs_n ${_rs_l})
    foreach(_rs_i RANGE 1 ${_rs_n})
        # t in 1/4096.
        math(EXPR _rs_t "${_rs_i} * 4096 / ${_rs_n}")
        math(EXPR _rs_u "4096 - ${_rs_t}")
        math(EXPR _rs_x "(${_rs_u} * ${_rs_u} * (${x0}) + 2 * ${_rs_u} * ${_rs_t} * (${x1}) + ${_rs_t} * ${_rs_t} * (${x2})) >> 24")
        math(EXPR _rs_y "(${_rs_u} * ${_rs_u} * (${y0}) + 2 * ${_rs_u} * ${_rs_t} * (${y1}) + ${_rs_t} * ${_rs_t} * (${y2})) >> 24")
        _rs_sp_add(${_rs_x} ${_rs_y})
    endforeach()
endmacro()

macro(_rs_cubic x0 y0 x1 y1 x2 y2 x3 y3)
    _rs_dist(_rs_l1 ${x0} ${y0} ${x1} ${y1})
    _rs_dist(_rs_l2 ${x1} ${y1} ${x2} ${y2})
    _rs_dist(_rs_l3 ${x2} ${y2} ${x3} ${y3})
    math(EXPR _rs_l "${_rs_l1} + ${_rs_l2} + ${_rs_l3}")
    _rs_pieces(_rs_n ${_rs_l})
    foreach(_rs_i RANGE 1 ${_rs_n})
        # t in 1/1024, the cube of it fits.
        math(EXPR _rs_t "${_rs_i} * 1024 / ${_rs_n}")
        math(EXPR _rs_u "1024 - ${_rs_t}")
        math(EXPR _rs_x "(${_rs_u} * ${_rs_u} * ${_rs_u} * (${x0}) + 3 * ${_rs_u} * ${_rs_u} * ${_rs_t} * (${x1}) + 3 * ${_rs_u} * ${_rs_t} * ${_rs_t} * (${x2}) + ${_rs_t} * ${_rs_t} * ${_rs_t} * (${x3})) >> 30")
        math(EXPR _rs_y "(${_rs_u} * ${_rs_u} * ${_rs_u} * (${y0}) + 3 * ${_rs_u} * ${_rs_u} * ${_rs_t} * (${y1}) + 3 * ${_rs_u} * ${_rs_t} * ${_rs_t} * (${y2}) + ${_rs_t} * ${_rs_t} * ${_rs_t} * (${y3})) >> 30")
        _rs_sp_add(${_rs_x} ${_rs_y})
    endforeach()
endmacro()

# Points of an ellipse around cx, cy from start through sweep degrees (1/65536), rotated by phi, the first point left out.
macro(_rs_ellipse_arc cx cy rx ry phi start sweep)
    _rs_abs(_rs_asweep ${sweep})
    set(_rs_r ${rx})
    if(${ry} GREATER ${rx})
        set(_rs_r ${ry})
    endif()
    # about a third of a device pixel away from the true curve.
    math(EXPR _rs_rd "(${_rs_r} * ${_rs_dscale} >> 48) + 1")
    _rs_isqrt(_rs_q "${_rs_rd} * 30")
    math(EXPR _rs_n "(${_rs_q} * ${_rs_asweep} / 23592960) + 2")
    if(_rs_n GREATER 256)
        set(_rs_n 256)
    endif()
    _rs_sincos(_rs_ps _rs_pc ${phi})
    math(EXPR _rs_step "(${sweep}) / ${_rs_n}")
    _rs_sincos(_rs_ss _rs_sc ${_rs_step})
    _rs_sincos(_rs_s _rs_c ${start})
    # the unit vector turns by the step each time, in 1/2^30.
    math(EXPR _rs_c "${_rs_c} * 16384")
    math(EXPR _rs_s "${_rs_s} * 16384")
    foreach(_rs_i RANGE 1 ${_rs_n})
        math(EXPR _rs_c2 "(${_rs_c} * ${_rs_sc} - ${_rs_s} * ${_rs_ss}) >> 16")
        math(EXPR _rs_s "(${_rs_s} * ${_rs_sc} + ${_rs_c} * ${_rs_ss}) >> 16")
        set(_rs_c ${_rs_c2})
        math(EXPR _rs_ex "(${rx}) * (${_rs_c} >> 14) >> 16")
        math(EXPR _rs_ey "(${ry}) * (${_rs_s} >> 14) >> 16")
        math(EXPR _rs_x "(${cx}) + ((${_rs_pc} * ${_rs_ex} - ${_rs_ps} * ${_rs_ey}) >> 16)")
        math(EXPR _rs_y "(${cy}) + ((${_rs_ps} * ${_rs_ex} + ${_rs_pc} * ${_rs_ey}) >> 16)")
        _rs_sp_add(${_rs_x} ${_rs_y})
    endforeach()
endmacro()

# An arc of a path from x1, y1 to x2, y2, as the SVG specification turns the end points into a center.
function(_rs_arc_center out x1 y1 x2 y2 rx ry phi large sweep)
    _rs_sincos(s c ${phi})
    # in 1/64, so the fourth powers fit.
    math(EXPR hx "((${x1}) - (${x2})) / 2")
    math(EXPR hy "((${y1}) - (${y2})) / 2")
    math(EXPR px "((${c} * ${hx} + ${s} * ${hy}) >> 16) >> 10")
    math(EXPR py "((-${s} * ${hx} + ${c} * ${hy}) >> 16) >> 10")
    _rs_abs(rx ${rx})
    _rs_abs(ry ${ry})
    math(EXPR rx "${rx} >> 10")
    math(EXPR ry "${ry} >> 10")
    if(rx EQUAL 0 OR ry EQUAL 0)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    # lambda in 1/2^20, radii grow when the points are too far apart.
    math(EXPR lambda "((${px} * ${px} << 20) / (${rx} * ${rx})) + ((${py} * ${py} << 20) / (${ry} * ${ry}))")
    if(lambda GREATER 1048576)
        _rs_isqrt(root "${lambda} << 20")
        math(EXPR rx "(${rx} * ${root} >> 20) + 1")
        math(EXPR ry "(${ry} * ${root} >> 20) + 1")
    endif()
    math(EXPR num "${rx} * ${rx} * ${ry} * ${ry} - ${rx} * ${rx} * ${py} * ${py} - ${ry} * ${ry} * ${px} * ${px}")
    math(EXPR den "${rx} * ${rx} * ${py} * ${py} + ${ry} * ${ry} * ${px} * ${px}")
    set(coef 0)
    if(num GREATER 0 AND den GREATER 0)
        # the ratio in 1/2^32, its root in 1/2^16.
        math(EXPR shift "0")
        while(num GREATER 2147483647)
            math(EXPR num "${num} >> 1")
            math(EXPR den "${den} >> 1")
        endwhile()
        if(den GREATER 0)
            math(EXPR ratio "(${num} << 32) / ${den}")
            _rs_isqrt(coef ${ratio})
        endif()
    endif()
    if(large EQUAL sweep)
        math(EXPR coef "-${coef}")
    endif()
    math(EXPR qx "${coef} * ${rx} * ${py} / ${ry} >> 16")
    math(EXPR qy "-${coef} * ${ry} * ${px} / ${rx} >> 16")
    math(EXPR cx "((${c} * ${qx} - ${s} * ${qy}) >> 6) + ((${x1}) + (${x2})) / 2")
    math(EXPR cy "((${s} * ${qx} + ${c} * ${qy}) >> 6) + ((${y1}) + (${y2})) / 2")
    math(EXPR ux "(${px} - ${qx}) * 65536 / ${rx}")
    math(EXPR uy "(${py} - ${qy}) * 65536 / ${ry}")
    math(EXPR vx "(-${px} - ${qx}) * 65536 / ${rx}")
    math(EXPR vy "(-${py} - ${qy}) * 65536 / ${ry}")
    _rs_atan2(start ${uy} ${ux})
    _rs_atan2(end ${vy} ${vx})
    math(EXPR delta "${end} - ${start}")
    if(sweep EQUAL 0 AND delta GREATER 0)
        math(EXPR delta "${delta} - 23592960")
    elseif(NOT sweep EQUAL 0 AND delta LESS 0)
        math(EXPR delta "${delta} + 23592960")
    endif()
    math(EXPR rx "${rx} << 10")
    math(EXPR ry "${ry} << 10")
    set(${out} "${cx};${cy};${rx};${ry};${start};${delta}" PARENT_SCOPE)
endfunction()

macro(_rs_path d)
    string(REGEX MATCHALL "[A-Za-z]|[-+]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][-+]?[0-9]+)?" _rs_tokens "${d}")
    set(_rs_cmd "")
    set(_rs_cx 0)
    set(_rs_cy 0)
    set(_rs_sx 0)
    set(_rs_sy 0)
    set(_rs_lcx "")
    set(_rs_lcy "")
    set(_rs_args)
    set(_rs_need 0)
    list(APPEND _rs_tokens "!")
    foreach(_rs_tok IN LISTS _rs_tokens)
        if(_rs_tok MATCHES "^[A-Za-z!]$")
            set(_rs_cmd "${_rs_tok}")
            set(_rs_args)
            string(TOUPPER "${_rs_cmd}" _rs_up)
            if(_rs_up STREQUAL "Z")
                if(_rs_spn GREATER 0)
                    set(_rs_spc_${_rs_spn} 1)
                endif()
                set(_rs_cx ${_rs_sx})
                set(_rs_cy ${_rs_sy})
                set(_rs_lcx "")
                set(_rs_need 0)
            elseif(_rs_up MATCHES "^[HV]$")
                set(_rs_need 1)
            elseif(_rs_up MATCHES "^[MLT]$")
                set(_rs_need 2)
            elseif(_rs_up MATCHES "^[SQ]$")
                set(_rs_need 4)
            elseif(_rs_up STREQUAL "C")
                set(_rs_need 6)
            elseif(_rs_up STREQUAL "A")
                set(_rs_need 7)
            else()
                set(_rs_need 0)
            endif()
            continue()
        endif()
        _rs_num(_rs_v "${_rs_tok}")
        list(APPEND _rs_args ${_rs_v})
        list(LENGTH _rs_args _rs_have)
        if(_rs_have LESS _rs_need)
            continue()
        endif()
        # relative coordinates are made absolute, the flags of an arc stay.
        set(_rs_rel 0)
        if(_rs_cmd MATCHES "^[a-z]$")
            set(_rs_rel 1)
        endif()
        set(_rs_abs)
        set(_rs_k 0)
        foreach(_rs_a IN LISTS _rs_args)
            if(_rs_rel)
                if(_rs_up STREQUAL "H")
                    math(EXPR _rs_a "${_rs_a} + ${_rs_cx}")
                elseif(_rs_up STREQUAL "V")
                    math(EXPR _rs_a "${_rs_a} + ${_rs_cy}")
                elseif(_rs_up STREQUAL "A")
                    if(_rs_k EQUAL 5)
                        math(EXPR _rs_a "${_rs_a} + ${_rs_cx}")
                    elseif(_rs_k EQUAL 6)
                        math(EXPR _rs_a "${_rs_a} + ${_rs_cy}")
                    endif()
                else()
                    math(EXPR _rs_odd "${_rs_k} % 2")
                    if(_rs_odd)
                        math(EXPR _rs_a "${_rs_a} + ${_rs_cy}")
                    else()
                        math(EXPR _rs_a "${_rs_a} + ${_rs_cx}")
                    endif()
                endif()
            endif()
            list(APPEND _rs_abs ${_rs_a})
            math(EXPR _rs_k "${_rs_k} + 1")
        endforeach()
        set(_rs_args)
        if(_rs_up STREQUAL "M")
            list(GET _rs_abs 0 _rs_cx)
            list(GET _rs_abs 1 _rs_cy)
            set(_rs_sx ${_rs_cx})
            set(_rs_sy ${_rs_cy})
            _rs_sp_begin(${_rs_cx} ${_rs_cy})
            set(_rs_lcx "")
            # coordinates after the first pair of a move are lines.
            if(_rs_rel)
                set(_rs_cmd "l")
            else()
                set(_rs_cmd "L")
            endif()
            set(_rs_up "L")
            continue()
        endif()
        if(_rs_spn EQUAL 0 OR _rs_spc_${_rs_spn})
            _rs_sp_begin(${_rs_cx} ${_rs_cy})
        endif()
        if(_rs_up STREQUAL "L")
            list(GET _rs_abs 0 _rs_cx)
            list(GET _rs_abs 1 _rs_cy)
            _rs_sp_add(${_rs_cx} ${_rs_cy})
            set(_rs_lcx "")
        elseif(_rs_up STREQUAL "H")
            list(GET _rs_abs 0 _rs_cx)
            _rs_sp_add(${_rs_cx} ${_rs_cy})
            set(_rs_lcx "")
        elseif(_rs_up STREQUAL "V")
            list(GET _rs_abs 0 _rs_cy)
            _rs_sp_add(${_rs_cx} ${_rs_cy})
            set(_rs_lcx "")
        elseif(_rs_up STREQUAL "Q" OR _rs_up STREQUAL "T")
            if(_rs_up STREQUAL "Q")
                list(GET _rs_abs 0 _rs_x1)
                list(GET _rs_abs 1 _rs_y1)
                list(GET _rs_abs 2 _rs_x2)
                list(GET _rs_abs 3 _rs_y2)
            else()
                if(_rs_lcx STREQUAL "" OR NOT _rs_lkind STREQUAL "Q")
                    set(_rs_x1 ${_rs_cx})
                    set(_rs_y1 ${_rs_cy})
                else()
                    math(EXPR _rs_x1 "2 * ${_rs_cx} - ${_rs_lcx}")
                    math(EXPR _rs_y1 "2 * ${_rs_cy} - ${_rs_lcy}")
                endif()
                list(GET _rs_abs 0 _rs_x2)
                list(GET _rs_abs 1 _rs_y2)
            endif()
            _rs_quad(${_rs_cx} ${_rs_cy} ${_rs_x1} ${_rs_y1} ${_rs_x2} ${_rs_y2})
            set(_rs_lcx ${_rs_x1})
            set(_rs_lcy ${_rs_y1})
            set(_rs_lkind Q)
            set(_rs_cx ${_rs_x2})
            set(_rs_cy ${_rs_y2})
        elseif(_rs_up STREQUAL "C" OR _rs_up STREQUAL "S")
            if(_rs_up STREQUAL "C")
                list(GET _rs_abs 0 _rs_x1)
                list(GET _rs_abs 1 _rs_y1)
                list(GET _rs_abs 2 _rs_x2)
                list(GET _rs_abs 3 _rs_y2)
                list(GET _rs_abs 4 _rs_x3)
                list(GET _rs_abs 5 _rs_y3)
            else()
                if(_rs_lcx STREQUAL "" OR NOT _rs_lkind STREQUAL "C")
                    set(_rs_x1 ${_rs_cx})
                    set(_rs_y1 ${_rs_cy})
                else()
                    math(EXPR _rs_x1 "2 * ${_rs_cx} - ${_rs_lcx}")
                    math(EXPR _rs_y1 "2 * ${_rs_cy} - ${_rs_lcy}")
                endif()
                list(GET _rs_abs 0 _rs_x2)
                list(GET _rs_abs 1 _rs_y2)
                list(GET _rs_abs 2 _rs_x3)
                list(GET _rs_abs 3 _rs_y3)
            endif()
            _rs_cubic(${_rs_cx} ${_rs_cy} ${_rs_x1} ${_rs_y1} ${_rs_x2} ${_rs_y2} ${_rs_x3} ${_rs_y3})
            set(_rs_lcx ${_rs_x2})
            set(_rs_lcy ${_rs_y2})
            set(_rs_lkind C)
            set(_rs_cx ${_rs_x3})
            set(_rs_cy ${_rs_y3})
        elseif(_rs_up STREQUAL "A")
            list(GET _rs_abs 0 _rs_arx)
            list(GET _rs_abs 1 _rs_ary)
            list(GET _rs_abs 2 _rs_aphi)
            list(GET _rs_abs 3 _rs_alarge)
            list(GET _rs_abs 4 _rs_asweep)
            list(GET _rs_abs 5 _rs_x2)
            list(GET _rs_abs 6 _rs_y2)
            if(NOT _rs_alarge EQUAL 0)
                set(_rs_alarge 1)
            endif()
            if(NOT _rs_asweep EQUAL 0)
                set(_rs_asweep 1)
            endif()
            _rs_arc_center(_rs_arc ${_rs_cx} ${_rs_cy} ${_rs_x2} ${_rs_y2} ${_rs_arx} ${_rs_ary} ${_rs_aphi} ${_rs_alarge} ${_rs_asweep})
            if(_rs_arc STREQUAL "")
                _rs_sp_add(${_rs_x2} ${_rs_y2})
            else()
                list(GET _rs_arc 0 _rs_acx)
                list(GET _rs_arc 1 _rs_acy)
                list(GET _rs_arc 2 _rs_arx)
                list(GET _rs_arc 3 _rs_ary)
                list(GET _rs_arc 4 _rs_astart)
                list(GET _rs_arc 5 _rs_adelta)
                _rs_ellipse_arc(${_rs_acx} ${_rs_acy} ${_rs_arx} ${_rs_ary} ${_rs_aphi} ${_rs_astart} ${_rs_adelta})
                # the last point is the end point exactly.
                list(LENGTH _rs_sp_${_rs_spn} _rs_len)
                math(EXPR _rs_len "${_rs_len} - 2")
                list(SUBLIST _rs_sp_${_rs_spn} 0 ${_rs_len} _rs_sp_${_rs_spn})
                _rs_sp_add(${_rs_x2} ${_rs_y2})
            endif()
            set(_rs_cx ${_rs_x2})
            set(_rs_cy ${_rs_y2})
            set(_rs_lcx "")
        endif()
    endforeach()
endmacro()

macro(_rs_ellipse cx cy rx ry)
    _rs_sp_begin(0 0)
    set(_rs_sp_${_rs_spn})
    math(EXPR _rs_x0 "${cx} + ${rx}")
    _rs_ellipse_arc(${cx} ${cy} ${rx} ${ry} 0 0 23592960)
    set(_rs_spc_${_rs_spn} 1)
endmacro()

macro(_rs_rect x y w h rx ry)
    if(${rx} LESS_EQUAL 0 OR ${ry} LESS_EQUAL 0)
        math(EXPR _rs_x1 "${x} + ${w}")
        math(EXPR _rs_y1 "${y} + ${h}")
        _rs_sp_begin(${x} ${y})
        _rs_sp_add(${_rs_x1} ${y})
        _rs_sp_add(${_rs_x1} ${_rs_y1})
        _rs_sp_add(${x} ${_rs_y1})
    else()
        math(EXPR _rs_x0 "${x} + ${rx}")
        math(EXPR _rs_x1 "${x} + ${w} - ${rx}")
        math(EXPR _rs_y0 "${y} + ${ry}")
        math(EXPR _rs_y1 "${y} + ${h} - ${ry}")
        math(EXPR _rs_xe "${x} + ${w}")
        math(EXPR _rs_ye "${y} + ${h}")
        _rs_sp_begin(${_rs_x0} ${y})
        _rs_sp_add(${_rs_x1} ${y})
        _rs_ellipse_arc(${_rs_x1} ${_rs_y0} ${rx} ${ry} 0 -5898240 5898240)
        _rs_sp_add(${_rs_xe} ${_rs_y1})
        _rs_ellipse_arc(${_rs_x1} ${_rs_y1} ${rx} ${ry} 0 0 5898240)
        _rs_sp_add(${_rs_x0} ${_rs_ye})
        _rs_ellipse_arc(${_rs_x0} ${_rs_y1} ${rx} ${ry} 0 5898240 5898240)
        _rs_sp_add(${x} ${_rs_y0})
        _rs_ellipse_arc(${_rs_x0} ${_rs_y0} ${rx} ${ry} 0 11796480 5898240)
    endif()
    set(_rs_spc_${_rs_spn} 1)
endmacro()

# The subpaths of an element, in user space.
macro(_rs_shape tag kind)
    set(_rs_spn 0)
    if(kind STREQUAL "path")
        _rs_attr(_rs_d "${tag}" d "")
        _rs_path("${_rs_d}")
    elseif(kind STREQUAL "rect")
        _rs_attr_num(_rs_x "${tag}" x 0)
        _rs_attr_num(_rs_y "${tag}" y 0)
        _rs_attr_num(_rs_w "${tag}" width 0)
        _rs_attr_num(_rs_h "${tag}" height 0)
        _rs_attr(_rs_t "${tag}" rx "")
        _rs_attr(_rs_t2 "${tag}" ry "")
        if(_rs_t STREQUAL "")
            set(_rs_t "${_rs_t2}")
        endif()
        if(_rs_t2 STREQUAL "")
            set(_rs_t2 "${_rs_t}")
        endif()
        if(_rs_t STREQUAL "")
            set(_rs_t 0)
            set(_rs_t2 0)
        endif()
        _rs_num(_rs_rx "${_rs_t}")
        _rs_num(_rs_ry "${_rs_t2}")
        math(EXPR _rs_hw "${_rs_w} / 2")
        math(EXPR _rs_hh "${_rs_h} / 2")
        if(_rs_rx GREATER _rs_hw)
            set(_rs_rx ${_rs_hw})
        endif()
        if(_rs_ry GREATER _rs_hh)
            set(_rs_ry ${_rs_hh})
        endif()
        if(_rs_w GREATER 0 AND _rs_h GREATER 0)
            _rs_rect(${_rs_x} ${_rs_y} ${_rs_w} ${_rs_h} ${_rs_rx} ${_rs_ry})
        endif()
    elseif(kind STREQUAL "circle" OR kind STREQUAL "ellipse")
        _rs_attr_num(_rs_x "${tag}" cx 0)
        _rs_attr_num(_rs_y "${tag}" cy 0)
        if(kind STREQUAL "circle")
            _rs_attr_num(_rs_rx "${tag}" r 0)
            set(_rs_ry ${_rs_rx})
        else()
            _rs_attr_num(_rs_rx "${tag}" rx 0)
            _rs_attr_num(_rs_ry "${tag}" ry 0)
        endif()
        if(_rs_rx GREATER 0 AND _rs_ry GREATER 0)
            _rs_ellipse(${_rs_x} ${_rs_y} ${_rs_rx} ${_rs_ry})
        endif()
    elseif(kind STREQUAL "line")
        _rs_attr_num(_rs_x "${tag}" x1 0)
        _rs_attr_num(_rs_y "${tag}" y1 0)
        _rs_attr_num(_rs_x2 "${tag}" x2 0)
        _rs_attr_num(_rs_y2 "${tag}" y2 0)
        _rs_sp_begin(${_rs_x} ${_rs_y})
        _rs_sp_add(${_rs_x2} ${_rs_y2})
    elseif(kind STREQUAL "polygon" OR kind STREQUAL "polyline")
        _rs_attr(_rs_pts "${tag}" points "")
        string(REGEX MATCHALL "[-+]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][-+]?[0-9]+)?" _rs_texts "${_rs_pts}")
        set(_rs_first 1)
        set(_rs_pending "")
        foreach(_rs_t IN LISTS _rs_texts)
            _rs_num(_rs_v "${_rs_t}")
            if(_rs_pending STREQUAL "")
                set(_rs_pending ${_rs_v})
            else()
                if(_rs_first)
                    _rs_sp_begin(${_rs_pending} ${_rs_v})
                    set(_rs_first 0)
                else()
                    _rs_sp_add(${_rs_pending} ${_rs_v})
                endif()
                set(_rs_pending "")
            endif()
        endforeach()
        if(kind STREQUAL "polygon" AND _rs_spn GREATER 0)
            set(_rs_spc_${_rs_spn} 1)
        endif()
    endif()
endmacro()

# ------------------------------------------------------------------ device space

# Subpaths to the device, into _rs_dp_<k>, and the box in user space into _rs_box.
macro(_rs_to_device m)
    set(_rs_mv "${m}")
    list(GET _rs_mv 0 _rs_ma)
    list(GET _rs_mv 1 _rs_mb)
    list(GET _rs_mv 2 _rs_mc)
    list(GET _rs_mv 3 _rs_md)
    list(GET _rs_mv 4 _rs_me)
    list(GET _rs_mv 5 _rs_mf)
    set(_rs_bx0 "")
    foreach(_rs_k RANGE 1 ${_rs_spn})
        if(_rs_spn EQUAL 0)
            break()
        endif()
        set(_rs_dp_${_rs_k})
        set(_rs_pend "")
        foreach(_rs_v IN LISTS _rs_sp_${_rs_k})
            if(_rs_pend STREQUAL "")
                set(_rs_pend ${_rs_v})
                continue()
            endif()
            if(_rs_bx0 STREQUAL "")
                set(_rs_bx0 ${_rs_pend})
                set(_rs_bx1 ${_rs_pend})
                set(_rs_by0 ${_rs_v})
                set(_rs_by1 ${_rs_v})
            else()
                if(_rs_pend LESS _rs_bx0)
                    set(_rs_bx0 ${_rs_pend})
                elseif(_rs_pend GREATER _rs_bx1)
                    set(_rs_bx1 ${_rs_pend})
                endif()
                if(_rs_v LESS _rs_by0)
                    set(_rs_by0 ${_rs_v})
                elseif(_rs_v GREATER _rs_by1)
                    set(_rs_by1 ${_rs_v})
                endif()
            endif()
            math(EXPR _rs_x "((${_rs_ma} * ${_rs_pend} + ${_rs_mc} * ${_rs_v}) >> 16) + ${_rs_me}")
            math(EXPR _rs_y "((${_rs_mb} * ${_rs_pend} + ${_rs_md} * ${_rs_v}) >> 16) + ${_rs_mf}")
            list(APPEND _rs_dp_${_rs_k} ${_rs_x} ${_rs_y})
            set(_rs_pend "")
        endforeach()
    endforeach()
endmacro()

# Polygons for the rasterizer are _rs_poly_<k>, x;y in device space, closed, _rs_polyn of them.
macro(_rs_poly_add points)
    math(EXPR _rs_polyn "${_rs_polyn} + 1")
    set(_rs_poly_${_rs_polyn} "${points}")
endmacro()

# A polygon turned to wind counterclockwise on the screen, so overlapping pieces of a stroke add up.
function(_rs_orient out points)
    list(LENGTH points n)
    if(n LESS 6)
        set(${out} "${points}" PARENT_SCOPE)
        return()
    endif()
    math(EXPR last "${n} - 2")
    list(GET points ${last} px)
    math(EXPR last "${n} - 1")
    list(GET points ${last} py)
    set(area 0)
    set(pend "")
    foreach(v IN LISTS points)
        if(pend STREQUAL "")
            set(pend ${v})
            continue()
        endif()
        math(EXPR area "${area} + ((${px} >> 8) * (${v} >> 8) - (${pend} >> 8) * (${py} >> 8))")
        set(px ${pend})
        set(py ${v})
        set(pend "")
    endforeach()
    if(area LESS 0)
        set(rev)
        set(pend "")
        foreach(v IN LISTS points)
            if(pend STREQUAL "")
                set(pend ${v})
                continue()
            endif()
            list(PREPEND rev ${pend} ${v})
            set(pend "")
        endforeach()
        set(points "${rev}")
    endif()
    set(${out} "${points}" PARENT_SCOPE)
endfunction()

# A disc of radius r at x, y.
function(_rs_disc out x y r)
    math(EXPR rp "(${r} >> 16) + 1")
    _rs_isqrt(q "${rp} * 30")
    math(EXPR n "${q} + 6")
    if(n GREATER 96)
        set(n 96)
    endif()
    math(EXPR step "23592960 / ${n}")
    _rs_sincos(ss sc ${step})
    set(c 1073741824)
    set(s 0)
    set(points)
    foreach(i RANGE 1 ${n})
        math(EXPR c2 "(${c} * ${sc} - ${s} * ${ss}) >> 16")
        math(EXPR s "(${s} * ${sc} + ${c} * ${ss}) >> 16")
        set(c ${c2})
        math(EXPR px "${x} + (${r} * (${c} >> 14) >> 16)")
        math(EXPR py "${y} + (${r} * (${s} >> 14) >> 16)")
        list(APPEND points ${px} ${py})
    endforeach()
    _rs_orient(points "${points}")
    set(${out} "${points}" PARENT_SCOPE)
endfunction()

# The outline of a stroke of the device subpaths, as polygons.
macro(_rs_stroke width join cap)
    math(EXPR _rs_h "(${width}) / 2")
    foreach(_rs_k RANGE 1 ${_rs_spn})
        if(_rs_spn EQUAL 0)
            break()
        endif()
        # the points without repeats.
        set(_rs_px)
        set(_rs_py)
        set(_rs_pend "")
        set(_rs_lx "")
        set(_rs_ly "")
        foreach(_rs_v IN LISTS _rs_dp_${_rs_k})
            if(_rs_pend STREQUAL "")
                set(_rs_pend ${_rs_v})
                continue()
            endif()
            math(EXPR _rs_ddx "${_rs_pend} - 0${_rs_lx}")
            math(EXPR _rs_ddy "${_rs_v} - 0${_rs_ly}")
            if(_rs_lx STREQUAL "" OR _rs_ddx GREATER 16 OR _rs_ddx LESS -16 OR _rs_ddy GREATER 16 OR _rs_ddy LESS -16)
                list(APPEND _rs_px ${_rs_pend})
                list(APPEND _rs_py ${_rs_v})
                set(_rs_lx ${_rs_pend})
                set(_rs_ly ${_rs_v})
            endif()
            set(_rs_pend "")
        endforeach()
        list(LENGTH _rs_px _rs_np)
        set(_rs_closed ${_rs_spc_${_rs_k}})
        if(_rs_closed AND _rs_np GREATER 2)
            list(GET _rs_px 0 _rs_fx)
            list(GET _rs_py 0 _rs_fy)
            math(EXPR _rs_li "${_rs_np} - 1")
            list(GET _rs_px ${_rs_li} _rs_lx)
            list(GET _rs_py ${_rs_li} _rs_ly)
            math(EXPR _rs_ddx "${_rs_fx} - ${_rs_lx}")
            math(EXPR _rs_ddy "${_rs_fy} - ${_rs_ly}")
            if(_rs_ddx GREATER 16 OR _rs_ddx LESS -16 OR _rs_ddy GREATER 16 OR _rs_ddy LESS -16)
                list(APPEND _rs_px ${_rs_fx})
                list(APPEND _rs_py ${_rs_fy})
                math(EXPR _rs_np "${_rs_np} + 1")
            endif()
        endif()
        if(_rs_np LESS 2)
            # a lone point gets its round or square cap only.
            if(_rs_np EQUAL 1 AND NOT cap STREQUAL "butt")
                list(GET _rs_px 0 _rs_x0)
                list(GET _rs_py 0 _rs_y0)
                if(cap STREQUAL "round")
                    _rs_disc(_rs_pts ${_rs_x0} ${_rs_y0} ${_rs_h})
                else()
                    math(EXPR _rs_a0 "${_rs_x0} - ${_rs_h}")
                    math(EXPR _rs_a1 "${_rs_x0} + ${_rs_h}")
                    math(EXPR _rs_b0 "${_rs_y0} - ${_rs_h}")
                    math(EXPR _rs_b1 "${_rs_y0} + ${_rs_h}")
                    set(_rs_pts "${_rs_a0};${_rs_b0};${_rs_a1};${_rs_b0};${_rs_a1};${_rs_b1};${_rs_a0};${_rs_b1}")
                endif()
                _rs_poly_add("${_rs_pts}")
            endif()
            continue()
        endif()
        # the unit normal of each segment, in 1/65536, times the half width.
        math(EXPR _rs_ns "${_rs_np} - 2")
        foreach(_rs_i RANGE 0 ${_rs_ns})
            math(EXPR _rs_j "${_rs_i} + 1")
            list(GET _rs_px ${_rs_i} _rs_x0)
            list(GET _rs_py ${_rs_i} _rs_y0)
            list(GET _rs_px ${_rs_j} _rs_x1)
            list(GET _rs_py ${_rs_j} _rs_y1)
            math(EXPR _rs_dx "${_rs_x1} - ${_rs_x0}")
            math(EXPR _rs_dy "${_rs_y1} - ${_rs_y0}")
            math(EXPR _rs_sq "(${_rs_dx} >> 2) * (${_rs_dx} >> 2) + (${_rs_dy} >> 2) * (${_rs_dy} >> 2)")
            _rs_isqrt(_rs_len ${_rs_sq})
            math(EXPR _rs_len "${_rs_len} << 2")
            if(_rs_len LESS 1)
                set(_rs_len 1)
            endif()
            math(EXPR _rs_nx_${_rs_i} "-${_rs_dy} * 65536 / ${_rs_len}")
            math(EXPR _rs_ny_${_rs_i} "${_rs_dx} * 65536 / ${_rs_len}")
            math(EXPR _rs_ox "${_rs_nx_${_rs_i}} * ${_rs_h} >> 16")
            math(EXPR _rs_oy "${_rs_ny_${_rs_i}} * ${_rs_h} >> 16")
            set(_rs_ex0 ${_rs_x0})
            set(_rs_ey0 ${_rs_y0})
            set(_rs_ex1 ${_rs_x1})
            set(_rs_ey1 ${_rs_y1})
            if(cap STREQUAL "square" AND NOT _rs_closed)
                math(EXPR _rs_tx "${_rs_dx} * ${_rs_h} / ${_rs_len}")
                math(EXPR _rs_ty "${_rs_dy} * ${_rs_h} / ${_rs_len}")
                if(_rs_i EQUAL 0)
                    math(EXPR _rs_ex0 "${_rs_x0} - ${_rs_tx}")
                    math(EXPR _rs_ey0 "${_rs_y0} - ${_rs_ty}")
                endif()
                if(_rs_i EQUAL _rs_ns)
                    math(EXPR _rs_ex1 "${_rs_x1} + ${_rs_tx}")
                    math(EXPR _rs_ey1 "${_rs_y1} + ${_rs_ty}")
                endif()
            endif()
            math(EXPR _rs_q0 "${_rs_ex0} + ${_rs_ox}")
            math(EXPR _rs_q1 "${_rs_ey0} + ${_rs_oy}")
            math(EXPR _rs_q2 "${_rs_ex1} + ${_rs_ox}")
            math(EXPR _rs_q3 "${_rs_ey1} + ${_rs_oy}")
            math(EXPR _rs_q4 "${_rs_ex1} - ${_rs_ox}")
            math(EXPR _rs_q5 "${_rs_ey1} - ${_rs_oy}")
            math(EXPR _rs_q6 "${_rs_ex0} - ${_rs_ox}")
            math(EXPR _rs_q7 "${_rs_ey0} - ${_rs_oy}")
            _rs_orient(_rs_pts "${_rs_q0};${_rs_q1};${_rs_q2};${_rs_q3};${_rs_q4};${_rs_q5};${_rs_q6};${_rs_q7}")
            _rs_poly_add("${_rs_pts}")
        endforeach()
        # joins at the inner points, and at the first one of a closed subpath.
        set(_rs_joins)
        if(_rs_np GREATER 2)
            math(EXPR _rs_jl "${_rs_np} - 2")
            foreach(_rs_i RANGE 1 ${_rs_jl})
                math(EXPR _rs_p "${_rs_i} - 1")
                list(APPEND _rs_joins "${_rs_i}:${_rs_p}:${_rs_i}")
            endforeach()
        endif()
        if(_rs_closed AND _rs_np GREATER 2)
            list(APPEND _rs_joins "0:${_rs_ns}:0")
        endif()
        foreach(_rs_jn IN LISTS _rs_joins)
            string(REPLACE ":" ";" _rs_jn "${_rs_jn}")
            list(GET _rs_jn 0 _rs_vi)
            list(GET _rs_jn 1 _rs_s1)
            list(GET _rs_jn 2 _rs_s2)
            list(GET _rs_px ${_rs_vi} _rs_x0)
            list(GET _rs_py ${_rs_vi} _rs_y0)
            if(join STREQUAL "round")
                _rs_disc(_rs_pts ${_rs_x0} ${_rs_y0} ${_rs_h})
                _rs_poly_add("${_rs_pts}")
                continue()
            endif()
            set(_rs_n1x ${_rs_nx_${_rs_s1}})
            set(_rs_n1y ${_rs_ny_${_rs_s1}})
            set(_rs_n2x ${_rs_nx_${_rs_s2}})
            set(_rs_n2y ${_rs_ny_${_rs_s2}})
            # the outer side is where the path turns away from.
            math(EXPR _rs_cross "(${_rs_n1x} >> 4) * (${_rs_n2y} >> 4) - (${_rs_n1y} >> 4) * (${_rs_n2x} >> 4)")
            if(_rs_cross EQUAL 0)
                continue()
            endif()
            if(_rs_cross GREATER 0)
                math(EXPR _rs_n1x "-${_rs_n1x}")
                math(EXPR _rs_n1y "-${_rs_n1y}")
                math(EXPR _rs_n2x "-${_rs_n2x}")
                math(EXPR _rs_n2y "-${_rs_n2y}")
            endif()
            math(EXPR _rs_a1x "${_rs_x0} + (${_rs_n1x} * ${_rs_h} >> 16)")
            math(EXPR _rs_a1y "${_rs_y0} + (${_rs_n1y} * ${_rs_h} >> 16)")
            math(EXPR _rs_a2x "${_rs_x0} + (${_rs_n2x} * ${_rs_h} >> 16)")
            math(EXPR _rs_a2y "${_rs_y0} + (${_rs_n2y} * ${_rs_h} >> 16)")
            math(EXPR _rs_bx "${_rs_n1x} + ${_rs_n2x}")
            math(EXPR _rs_by "${_rs_n1y} + ${_rs_n2y}")
            math(EXPR _rs_bb "(${_rs_bx} * ${_rs_bx} + ${_rs_by} * ${_rs_by}) >> 16")
            # the miter is 2 / |b| half widths long, past a limit of 4 it is cut.
            if(join STREQUAL "miter" AND _rs_bb GREATER 16384)
                math(EXPR _rs_mx "${_rs_x0} + ${_rs_bx} * 2 * ${_rs_h} / ${_rs_bb}")
                math(EXPR _rs_my "${_rs_y0} + ${_rs_by} * 2 * ${_rs_h} / ${_rs_bb}")
                _rs_orient(_rs_pts "${_rs_x0};${_rs_y0};${_rs_a1x};${_rs_a1y};${_rs_mx};${_rs_my};${_rs_a2x};${_rs_a2y}")
            else()
                _rs_orient(_rs_pts "${_rs_x0};${_rs_y0};${_rs_a1x};${_rs_a1y};${_rs_a2x};${_rs_a2y}")
            endif()
            _rs_poly_add("${_rs_pts}")
        endforeach()
        if(NOT _rs_closed AND cap STREQUAL "round")
            list(GET _rs_px 0 _rs_x0)
            list(GET _rs_py 0 _rs_y0)
            _rs_disc(_rs_pts ${_rs_x0} ${_rs_y0} ${_rs_h})
            _rs_poly_add("${_rs_pts}")
            math(EXPR _rs_li "${_rs_np} - 1")
            list(GET _rs_px ${_rs_li} _rs_x0)
            list(GET _rs_py ${_rs_li} _rs_y0)
            _rs_disc(_rs_pts ${_rs_x0} ${_rs_y0} ${_rs_h})
            _rs_poly_add("${_rs_pts}")
        endif()
    endforeach()
endmacro()

# ------------------------------------------------------------------ scan conversion and painting

# The color a paint gives at the center of pixel x, y as r;g;b;a, for a gradient whose t = (gx x + gy y + g0) >> 16.
macro(_rs_color_at x y)
    if(_rs_kind STREQUAL "solid")
        set(_rs_col "${_rs_solid}")
    else()
        math(EXPR _rs_t "(${_rs_ggx} * (${x} * 2 + 1) + ${_rs_ggy} * (${y} * 2 + 1)) / 2 + ${_rs_gg0}")
        if(_rs_t LESS 0)
            set(_rs_t 0)
        elseif(_rs_t GREATER 65536)
            set(_rs_t 65536)
        endif()
        # stops are offset;r;g;b;a, offsets in 1/65536.
        set(_rs_prev "")
        set(_rs_col "")
        foreach(_rs_stop IN LISTS _rs_stops)
            string(REPLACE ":" ";" _rs_st "${_rs_stop}")
            list(GET _rs_st 0 _rs_so)
            if(_rs_t LESS_EQUAL _rs_so)
                if(_rs_prev STREQUAL "")
                    list(SUBLIST _rs_st 1 4 _rs_col)
                else()
                    string(REPLACE ":" ";" _rs_pst "${_rs_prev}")
                    list(GET _rs_pst 0 _rs_po)
                    math(EXPR _rs_span "${_rs_so} - ${_rs_po}")
                    if(_rs_span LESS 1)
                        set(_rs_span 1)
                    endif()
                    math(EXPR _rs_f "(${_rs_t} - ${_rs_po}) * 256 / ${_rs_span}")
                    set(_rs_col)
                    foreach(_rs_ci 1 2 3 4)
                        list(GET _rs_pst ${_rs_ci} _rs_c0)
                        list(GET _rs_st ${_rs_ci} _rs_c1)
                        math(EXPR _rs_cv "${_rs_c0} + ((${_rs_c1} - ${_rs_c0}) * ${_rs_f} + 128) / 256")
                        list(APPEND _rs_col ${_rs_cv})
                    endforeach()
                endif()
                break()
            endif()
            set(_rs_prev "${_rs_stop}")
        endforeach()
        if(_rs_col STREQUAL "")
            string(REPLACE ":" ";" _rs_st "${_rs_prev}")
            list(SUBLIST _rs_st 1 4 _rs_col)
        endif()
    endif()
    list(GET _rs_col 0 _rs_cr)
    list(GET _rs_col 1 _rs_cg)
    list(GET _rs_col 2 _rs_cb)
    list(GET _rs_col 3 _rs_ca)
    # alpha with the opacity, 0 to 65536.
    math(EXPR _rs_ca "${_rs_ca} * ${_rs_opacity} * 257 >> 8")
endmacro()

# Paints a pixel with the color above at a coverage of 0 to 65536.
macro(_rs_blend x y cov)
    math(EXPR _rs_ea "${_rs_ca} * (${cov}) >> 16")
    if(_rs_ea GREATER_EQUAL 65535)
        math(EXPR _rs_px_${x}_${y} "(${_rs_cr} << 24) | (${_rs_cg} << 16) | (${_rs_cb} << 8) | 255")
    elseif(_rs_ea GREATER 0)
        set(_rs_d 0${_rs_px_${x}_${y}})
        math(EXPR _rs_px_${x}_${y} "((((${_rs_cr} * ${_rs_ea} + ((${_rs_d} >> 24) & 255) * (65536 - ${_rs_ea}) + 32768) >> 16) << 24) | (((${_rs_cg} * ${_rs_ea} + ((${_rs_d} >> 16) & 255) * (65536 - ${_rs_ea}) + 32768) >> 16) << 16) | (((${_rs_cb} * ${_rs_ea} + ((${_rs_d} >> 8) & 255) * (65536 - ${_rs_ea}) + 32768) >> 16) << 8) | ((255 * ${_rs_ea} + (${_rs_d} & 255) * (65536 - ${_rs_ea}) + 32768) >> 16))")
    endif()
endmacro()

# Fills the polygons _rs_poly_1.._rs_polyn with the paint, by the nonzero rule.
macro(_rs_fill)
    # edges as x0, y0, x1, y1 with y0 < y1 and the direction, kept by the first pixel row they touch.
    set(_rs_ne 0)
    set(_rs_ymin "")
    foreach(_rs_k RANGE 1 ${_rs_polyn})
        if(_rs_polyn EQUAL 0)
            break()
        endif()
        list(LENGTH _rs_poly_${_rs_k} _rs_len)
        if(_rs_len LESS 6)
            continue()
        endif()
        math(EXPR _rs_li "${_rs_len} - 2")
        list(GET _rs_poly_${_rs_k} ${_rs_li} _rs_px0)
        math(EXPR _rs_li "${_rs_len} - 1")
        list(GET _rs_poly_${_rs_k} ${_rs_li} _rs_py0)
        set(_rs_pend "")
        foreach(_rs_v IN LISTS _rs_poly_${_rs_k})
            if(_rs_pend STREQUAL "")
                set(_rs_pend ${_rs_v})
                continue()
            endif()
            if(NOT _rs_v EQUAL _rs_py0)
                math(EXPR _rs_ne "${_rs_ne} + 1")
                if(_rs_v GREATER _rs_py0)
                    set(_rs_e "${_rs_px0};${_rs_py0};${_rs_pend};${_rs_v};1")
                    set(_rs_top ${_rs_py0})
                    set(_rs_bot ${_rs_v})
                else()
                    set(_rs_e "${_rs_pend};${_rs_v};${_rs_px0};${_rs_py0};-1")
                    set(_rs_top ${_rs_v})
                    set(_rs_bot ${_rs_py0})
                endif()
                set(_rs_edge_${_rs_ne} "${_rs_e}")
                math(EXPR _rs_row "${_rs_top} >> 16")
                if(_rs_row LESS 0)
                    set(_rs_row 0)
                endif()
                if(_rs_row GREATER _rs_last)
                    math(EXPR _rs_ne "${_rs_ne} - 1")
                    set(_rs_px0 ${_rs_pend})
                    set(_rs_py0 ${_rs_v})
                    set(_rs_pend "")
                    continue()
                endif()
                list(APPEND _rs_bucket_${_rs_row} ${_rs_ne})
                if(_rs_ymin STREQUAL "" OR _rs_row LESS _rs_ymin)
                    set(_rs_ymin ${_rs_row})
                endif()
                math(EXPR _rs_brow "(${_rs_bot} - 1) >> 16")
                if(NOT DEFINED _rs_ymax OR _rs_brow GREATER _rs_ymax)
                    set(_rs_ymax ${_rs_brow})
                endif()
            endif()
            set(_rs_px0 ${_rs_pend})
            set(_rs_py0 ${_rs_v})
            set(_rs_pend "")
        endforeach()
    endforeach()
    if(_rs_ne GREATER 0)
        if(_rs_ymax GREATER _rs_last)
            set(_rs_ymax ${_rs_last})
        endif()
        set(_rs_active)
        set(_rs_xlimit ${_rs_size})
        math(EXPR _rs_xlimit "${_rs_size} << 16")
        if(_rs_ymin LESS_EQUAL _rs_ymax)
        foreach(_rs_y RANGE ${_rs_ymin} ${_rs_ymax})
            list(APPEND _rs_active ${_rs_bucket_${_rs_y}})
            set(_rs_bucket_${_rs_y})
            math(EXPR _rs_rowtop "${_rs_y} << 16")
            set(_rs_keep)
            foreach(_rs_e IN LISTS _rs_active)
                list(GET _rs_edge_${_rs_e} 3 _rs_bot)
                if(_rs_bot GREATER _rs_rowtop)
                    list(APPEND _rs_keep ${_rs_e})
                endif()
            endforeach()
            set(_rs_active ${_rs_keep})
            if(NOT _rs_active)
                continue()
            endif()
            set(_rs_touched)
            foreach(_rs_s RANGE 1 ${_rs_samples})
                math(EXPR _rs_sy "${_rs_rowtop} + (2 * ${_rs_s} - 1) * 32768 / ${_rs_samples}")
                set(_rs_cross)
                foreach(_rs_e IN LISTS _rs_active)
                    set(_rs_ed ${_rs_edge_${_rs_e}})
                    list(GET _rs_ed 1 _rs_ey0)
                    list(GET _rs_ed 3 _rs_ey1)
                    if(_rs_sy LESS _rs_ey0 OR _rs_sy GREATER_EQUAL _rs_ey1)
                        continue()
                    endif()
                    list(GET _rs_ed 0 _rs_ex0)
                    list(GET _rs_ed 2 _rs_ex1)
                    list(GET _rs_ed 4 _rs_dir)
                    math(EXPR _rs_cx "${_rs_ex0} + (${_rs_sy} - ${_rs_ey0}) * (${_rs_ex1} - ${_rs_ex0}) / (${_rs_ey1} - ${_rs_ey0}) + 1073741824")
                    list(APPEND _rs_cross "${_rs_cx}_${_rs_dir}")
                endforeach()
                if(NOT _rs_cross)
                    continue()
                endif()
                list(SORT _rs_cross COMPARE NATURAL)
                set(_rs_wind 0)
                foreach(_rs_c IN LISTS _rs_cross)
                    string(FIND "${_rs_c}" "_" _rs_us)
                    string(SUBSTRING "${_rs_c}" 0 ${_rs_us} _rs_cx)
                    math(EXPR _rs_us "${_rs_us} + 1")
                    string(SUBSTRING "${_rs_c}" ${_rs_us} -1 _rs_dir)
                    math(EXPR _rs_cx "${_rs_cx} - 1073741824")
                    if(_rs_cx LESS 0)
                        set(_rs_cx 0)
                    elseif(_rs_cx GREATER _rs_xlimit)
                        set(_rs_cx ${_rs_xlimit})
                    endif()
                    set(_rs_was ${_rs_wind})
                    math(EXPR _rs_wind "${_rs_wind} + ${_rs_dir}")
                    if(_rs_was EQUAL 0)
                        set(_rs_xs ${_rs_cx})
                    elseif(_rs_wind EQUAL 0 AND _rs_cx GREATER _rs_xs)
                        # a span from xs to cx on this line, each line weighs 65536 / samples.
                        math(EXPR _rs_i0 "${_rs_xs} >> 16")
                        math(EXPR _rs_i1 "${_rs_cx} >> 16")
                        if(_rs_i0 EQUAL _rs_i1)
                            math(EXPR _rs_c_${_rs_i0} "0${_rs_c_${_rs_i0}} + (${_rs_cx} - ${_rs_xs}) / ${_rs_samples}")
                            list(APPEND _rs_touched ${_rs_i0})
                        else()
                            math(EXPR _rs_c_${_rs_i0} "0${_rs_c_${_rs_i0}} + (((${_rs_i0} + 1) << 16) - ${_rs_xs}) / ${_rs_samples}")
                            math(EXPR _rs_n0 "${_rs_i0} + 1")
                            math(EXPR _rs_d_${_rs_n0} "0${_rs_d_${_rs_n0}} + 65536 / ${_rs_samples}")
                            math(EXPR _rs_d_${_rs_i1} "0${_rs_d_${_rs_i1}} - 65536 / ${_rs_samples}")
                            math(EXPR _rs_c_${_rs_i1} "0${_rs_c_${_rs_i1}} + (${_rs_cx} - (${_rs_i1} << 16)) / ${_rs_samples}")
                            list(APPEND _rs_touched ${_rs_i0} ${_rs_n0} ${_rs_i1})
                        endif()
                    endif()
                endforeach()
            endforeach()
            if(NOT _rs_touched)
                continue()
            endif()
            list(REMOVE_DUPLICATES _rs_touched)
            list(SORT _rs_touched COMPARE NATURAL)
            set(_rs_run 0)
            set(_rs_rowcolor "")
            list(APPEND _rs_touched ${_rs_size})
            set(_rs_prevx "")
            foreach(_rs_x IN LISTS _rs_touched)
                if(NOT _rs_prevx STREQUAL "")
                    # the pixels between the touched ones are covered by the running sum alone.
                    math(EXPR _rs_from "${_rs_prevx} + 1")
                    math(EXPR _rs_to "${_rs_x} - 1")
                    if(_rs_run GREATER 0 AND _rs_from LESS_EQUAL _rs_to)
                        if(_rs_kind STREQUAL "solid" OR _rs_ggx EQUAL 0)
                            _rs_color_at(${_rs_from} ${_rs_y})
                            math(EXPR _rs_ea "${_rs_ca} * ${_rs_run} >> 16")
                            if(_rs_ea GREATER_EQUAL 65535)
                                math(EXPR _rs_full "(${_rs_cr} << 24) | (${_rs_cg} << 16) | (${_rs_cb} << 8) | 255")
                                foreach(_rs_xx RANGE ${_rs_from} ${_rs_to})
                                    set(_rs_px_${_rs_xx}_${_rs_y} ${_rs_full})
                                endforeach()
                            else()
                                foreach(_rs_xx RANGE ${_rs_from} ${_rs_to})
                                    _rs_blend(${_rs_xx} ${_rs_y} ${_rs_run})
                                endforeach()
                            endif()
                        else()
                            foreach(_rs_xx RANGE ${_rs_from} ${_rs_to})
                                _rs_color_at(${_rs_xx} ${_rs_y})
                                _rs_blend(${_rs_xx} ${_rs_y} ${_rs_run})
                            endforeach()
                        endif()
                    endif()
                endif()
                if(_rs_x GREATER_EQUAL _rs_size)
                    break()
                endif()
                math(EXPR _rs_run "${_rs_run} + 0${_rs_d_${_rs_x}}")
                math(EXPR _rs_cov "${_rs_run} + 0${_rs_c_${_rs_x}}")
                set(_rs_c_${_rs_x})
                set(_rs_d_${_rs_x})
                if(_rs_cov GREATER 65536)
                    set(_rs_cov 65536)
                endif()
                if(_rs_cov GREATER 0)
                    _rs_color_at(${_rs_x} ${_rs_y})
                    _rs_blend(${_rs_x} ${_rs_y} ${_rs_cov})
                endif()
                set(_rs_prevx ${_rs_x})
            endforeach()
        endforeach()
        endif()
    endif()
    unset(_rs_ymax)
endmacro()

# Sets the paint for _rs_fill from a paint and the element's box in user space and matrix.
macro(_rs_use_paint paint opacity m)
    set(_rs_mv "${m}")
    set(_rs_pv "${paint}")
    set(_rs_opacity ${opacity})
    list(GET _rs_pv 0 _rs_kind)
    if(_rs_kind STREQUAL "solid")
        list(SUBLIST _rs_pv 1 4 _rs_solid)
    else()
        list(GET _rs_pv 1 _rs_gid)
        if(NOT DEFINED _rs_grad_${_rs_gid})
            message(FATAL_ERROR "svg: no gradient ${_rs_gid}")
        endif()
        set(_rs_kind gradient)
        set(_rs_gv ${_rs_grad_${_rs_gid}})
        list(GET _rs_gv 0 _rs_gx1)
        list(GET _rs_gv 1 _rs_gy1)
        list(GET _rs_gv 2 _rs_gx2)
        list(GET _rs_gv 3 _rs_gy2)
        list(SUBLIST _rs_gv 4 -1 _rs_stops)
        # the vector from the box fractions to the device, t grows along it from 0 to 1.
        math(EXPR _rs_bw "${_rs_bx1} - ${_rs_bx0}")
        math(EXPR _rs_bh "${_rs_by1} - ${_rs_by0}")
        math(EXPR _rs_ux1 "${_rs_bx0} + (${_rs_bw} * ${_rs_gx1} >> 16)")
        math(EXPR _rs_uy1 "${_rs_by0} + (${_rs_bh} * ${_rs_gy1} >> 16)")
        math(EXPR _rs_ux2 "${_rs_bx0} + (${_rs_bw} * ${_rs_gx2} >> 16)")
        math(EXPR _rs_uy2 "${_rs_by0} + (${_rs_bh} * ${_rs_gy2} >> 16)")
        list(GET _rs_mv 0 _rs_ma)
        list(GET _rs_mv 1 _rs_mb)
        list(GET _rs_mv 2 _rs_mc)
        list(GET _rs_mv 3 _rs_md)
        list(GET _rs_mv 4 _rs_me)
        list(GET _rs_mv 5 _rs_mf)
        # device points in 1/256 pixel.
        math(EXPR _rs_dx1 "(((${_rs_ma} * ${_rs_ux1} + ${_rs_mc} * ${_rs_uy1}) >> 16) + ${_rs_me}) >> 8")
        math(EXPR _rs_dy1 "(((${_rs_mb} * ${_rs_ux1} + ${_rs_md} * ${_rs_uy1}) >> 16) + ${_rs_mf}) >> 8")
        math(EXPR _rs_dx2 "(((${_rs_ma} * ${_rs_ux2} + ${_rs_mc} * ${_rs_uy2}) >> 16) + ${_rs_me}) >> 8")
        math(EXPR _rs_dy2 "(((${_rs_mb} * ${_rs_ux2} + ${_rs_md} * ${_rs_uy2}) >> 16) + ${_rs_mf}) >> 8")
        math(EXPR _rs_vx "${_rs_dx2} - ${_rs_dx1}")
        math(EXPR _rs_vy "${_rs_dy2} - ${_rs_dy1}")
        math(EXPR _rs_vv "${_rs_vx} * ${_rs_vx} + ${_rs_vy} * ${_rs_vy}")
        if(_rs_vv LESS 1)
            set(_rs_vv 1)
        endif()
        # t = ((p - d1) . v) / |v|^2 with p the pixel center in 1/256: per pixel step gx, gy in 1/65536 of t.
        math(EXPR _rs_ggx "${_rs_vx} * 256 * 65536 / ${_rs_vv}")
        math(EXPR _rs_ggy "${_rs_vy} * 256 * 65536 / ${_rs_vv}")
        math(EXPR _rs_gg0 "-(${_rs_dx1} * ${_rs_vx} + ${_rs_dy1} * ${_rs_vy}) * 65536 / ${_rs_vv}")
    endif()
endmacro()

# Renders an SVG document at size by size pixels, or size by the height given after it. Sets out_0, out_1... to the rows, top first, as lists of packed
# 0xRRGGBBAA integers that are not premultiplied.
function(mime_svg_render out svg size)
    set(height ${size})
    if(ARGC GREATER 3)
        set(height ${ARGV3})
    endif()
    string(REGEX REPLACE "<!--.*-->" "" svg "${svg}")
    string(REGEX MATCHALL "<[^>]*>" tags "${svg}")
    set(_rs_size ${size})
    math(EXPR _rs_last "${height} - 1")
    math(EXPR _rs_lastx "${size} - 1")
    if(size LESS_EQUAL 48)
        set(_rs_samples 16)
    elseif(size LESS_EQUAL 96)
        set(_rs_samples 8)
    else()
        set(_rs_samples 4)
    endif()
    # the view box to the pixels.
    list(GET tags 0 root)
    foreach(t IN LISTS tags)
        if(t MATCHES "^<svg[ \t\n>]")
            set(root "${t}")
            break()
        endif()
    endforeach()
    _rs_attr(view "${root}" viewBox "")
    if(view STREQUAL "")
        _rs_attr(vw "${root}" width "${size}")
        _rs_attr(vh "${root}" height "${size}")
        set(view "0 0 ${vw} ${vh}")
    endif()
    string(REGEX MATCHALL "[-+]?[0-9]*\\.?[0-9]+" view "${view}")
    list(GET view 0 vx)
    list(GET view 1 vy)
    list(GET view 2 vw)
    list(GET view 3 vh)
    _rs_num(vx "${vx}")
    _rs_num(vy "${vy}")
    _rs_num(vw "${vw}")
    _rs_num(vh "${vh}")
    math(EXPR sx "(${size} << 32) / ${vw}")
    math(EXPR sy "(${height} << 32) / ${vh}")
    math(EXPR tx "-${vx} * ${sx} >> 16")
    math(EXPR ty "-${vy} * ${sy} >> 16")
    set(base "${sx};0;0;${sy};${tx};${ty}")
    # the gradients of the defs first, they may come after their use.
    set(grad "")
    foreach(t IN LISTS tags)
        if(t MATCHES "^<linearGradient")
            _rs_attr(grad "${t}" id "")
            _rs_attr(gx1 "${t}" x1 "0")
            _rs_attr(gy1 "${t}" y1 "0")
            _rs_attr(gx2 "${t}" x2 "1")
            _rs_attr(gy2 "${t}" y2 "0")
            set(gv)
            foreach(v gx1 gy1 gx2 gy2)
                if(${v} MATCHES "%$")
                    string(REGEX REPLACE "%$" "" ${v} "${${v}}")
                    _rs_num(n "${${v}}")
                    math(EXPR n "${n} / 100")
                else()
                    _rs_num(n "${${v}}")
                endif()
                list(APPEND gv ${n})
            endforeach()
            set(_rs_grad_${grad} "${gv}")
        elseif(t MATCHES "^<stop" AND NOT grad STREQUAL "")
            _rs_attr(off "${t}" offset "0")
            if(off MATCHES "%$")
                string(REGEX REPLACE "%$" "" off "${off}")
                _rs_num(off "${off}")
                math(EXPR off "${off} / 100")
            else()
                _rs_num(off "${off}")
            endif()
            _rs_attr(sc "${t}" stop-color "#000000")
            _rs_paint(p "${sc}")
            list(SUBLIST p 1 4 c)
            _rs_attr(so "${t}" stop-opacity "1")
            _rs_num(so "${so}")
            list(GET c 3 a)
            math(EXPR a "${a} * ${so} >> 16")
            list(REMOVE_AT c 3)
            list(APPEND c ${a})
            string(REPLACE ";" ":" c "${off};${c}")
            list(APPEND _rs_grad_${grad} "${c}")
        elseif(t MATCHES "^</linearGradient")
            set(grad "")
        endif()
    endforeach()
    # the stack of groups: matrix, opacity in 1/256, inherited paint attributes.
    set(depth 0)
    set(m_0 "${base}")
    set(op_0 256)
    set(fill_0 "#000000")
    set(stroke_0 "none")
    set(sw_0 "1")
    set(join_0 "miter")
    set(cap_0 "butt")
    set(in_defs 0)
    foreach(t IN LISTS tags)
        if(t MATCHES "^<defs")
            if(NOT t MATCHES "/>$")
                set(in_defs 1)
            endif()
            continue()
        elseif(t MATCHES "^</defs")
            set(in_defs 0)
            continue()
        endif()
        if(in_defs)
            continue()
        endif()
        if(t MATCHES "^</g")
            math(EXPR depth "${depth} - 1")
            continue()
        endif()
        if(NOT t MATCHES "^<(g|path|rect|circle|ellipse|line|polyline|polygon)[ \t\n/>]")
            continue()
        endif()
        set(kind "${CMAKE_MATCH_1}")
        _rs_attr(tf "${t}" transform "")
        set(m "${m_${depth}}")
        if(NOT tf STREQUAL "")
            _rs_transform(m "${m}" "${tf}")
        endif()
        _rs_attr(o "${t}" opacity "1")
        _rs_num(o "${o}")
        math(EXPR op "${op_${depth}} * ${o} >> 16")
        _rs_attr(fill "${t}" fill "${fill_${depth}}")
        _rs_attr(stroke "${t}" stroke "${stroke_${depth}}")
        _rs_attr(sw "${t}" stroke-width "${sw_${depth}}")
        _rs_attr(join "${t}" stroke-linejoin "${join_${depth}}")
        _rs_attr(cap "${t}" stroke-linecap "${cap_${depth}}")
        if(kind STREQUAL "g")
            if(NOT t MATCHES "/>$")
                math(EXPR depth "${depth} + 1")
                set(m_${depth} "${m}")
                set(op_${depth} ${op})
                set(fill_${depth} "${fill}")
                set(stroke_${depth} "${stroke}")
                set(sw_${depth} "${sw}")
                set(join_${depth} "${join}")
                set(cap_${depth} "${cap}")
            endif()
            continue()
        endif()
        _rs_attr(fo "${t}" fill-opacity "1")
        _rs_attr(so "${t}" stroke-opacity "1")
        _rs_num(fo "${fo}")
        _rs_num(so "${so}")
        math(EXPR fop "${op} * ${fo} >> 16")
        math(EXPR sop "${op} * ${so} >> 16")
        # the device size of a user unit, for how finely curves are cut, in 1/2^32.
        list(GET m 0 ma)
        list(GET m 1 mb)
        list(GET m 2 mc)
        list(GET m 3 md)
        math(EXPR det "(${ma} * ${md} - ${mb} * ${mc}) >> 16")
        if(det LESS 0)
            math(EXPR det "-${det}")
        endif()
        _rs_isqrt(scale "${det} << 16")
        math(EXPR _rs_dscale "${scale} << 16")
        _rs_shape("${t}" ${kind})
        if(_rs_spn EQUAL 0)
            continue()
        endif()
        _rs_to_device("${m}")
        _rs_paint(fp "${fill}")
        if(NOT fp STREQUAL "none" AND NOT kind STREQUAL "line")
            set(_rs_polyn 0)
            foreach(k RANGE 1 ${_rs_spn})
                list(LENGTH _rs_dp_${k} n)
                if(n GREATER_EQUAL 6)
                    _rs_poly_add("${_rs_dp_${k}}")
                endif()
            endforeach()
            _rs_use_paint("${fp}" ${fop} "${m}")
            _rs_fill()
        endif()
        _rs_paint(spaint "${stroke}")
        if(NOT spaint STREQUAL "none")
            _rs_num(w "${sw}")
            math(EXPR w "${w} * ${scale} >> 16")
            if(w GREATER 0)
                set(_rs_polyn 0)
                _rs_stroke(${w} ${join} ${cap})
                _rs_use_paint("${spaint}" ${sop} "${m}")
                _rs_fill()
            endif()
        endif()
    endforeach()
    # back from premultiplied, a variable for each row.
    foreach(y RANGE ${_rs_last})
        set(row "")
        foreach(x RANGE ${_rs_lastx})
            set(p 0${_rs_px_${x}_${y}})
            math(EXPR a "${p} & 255")
            if(a EQUAL 0)
                string(APPEND row ";0")
            elseif(a EQUAL 255)
                string(APPEND row ";${_rs_px_${x}_${y}}")
            else()
                math(EXPR p "((((${p} >> 24) & 255) * 255 + ${a} / 2) / ${a} << 24) | ((((${p} >> 16) & 255) * 255 + ${a} / 2) / ${a} << 16) | ((((${p} >> 8) & 255) * 255 + ${a} / 2) / ${a} << 8) | ${a}")
                string(APPEND row ";${p}")
            endif()
        endforeach()
        string(SUBSTRING "${row}" 1 -1 row)
        set(${out}_${y} "${row}" PARENT_SCOPE)
    endforeach()
endfunction()
