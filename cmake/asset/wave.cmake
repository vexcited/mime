# Synthesizes a system sound from its recipe into a 16 bit mono PCM wave file, run with cmake -P:
#   -DINPUT=<recipe> -DOUTPUT=<file.wav>
# A recipe has one statement a line, # starts a comment:
#   rate <hz>                                  22050 when not given
#   partials <name> <harmonic> <level> ...     a timbre, harmonics of the note's frequency with their levels
#   note <hz> <start> <length> <gain> <decay> <partials> [attack]
# Times are in seconds. A note is its partials as sines, under a linear attack (6 ms when not given), an exponential
# decay of e^(-decay t) and a 20 ms fade at the end. Partials at or above rate / 2.2 are left out. The notes are mixed,
# then brought down to a peak of 0.8 if they go above it.
include(${CMAKE_CURRENT_LIST_DIR}/binary.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/raster.cmake)

# sin of an angle in radians, both 1/2^30, for |x| up to pi.
function(_wave_sin out x)
    if(x GREATER 1686629713)
        math(EXPR x "3373259426 - ${x}")
    elseif(x LESS -1686629713)
        math(EXPR x "-3373259426 - ${x}")
    endif()
    math(EXPR x2 "${x} * ${x} >> 30")
    math(EXPR v "${x} * (1073741824 - ((${x2} / 6) * (1073741824 - ((${x2} / 20) * (1073741824 - ((${x2} / 42) * (1073741824 - ((${x2} / 72) * (1073741824 - ((${x2} / 110) * (1073741824 - ${x2} / 156) >> 30)) >> 30)) >> 30)) >> 30)) >> 30)) >> 30")
    set(${out} ${v} PARENT_SCOPE)
endfunction()

# A decimal in millionths, so times turn into whole samples exactly.
function(_wave_micros out text)
    if(NOT text MATCHES "^([0-9]*)(\\.([0-9]*))?$")
        message(FATAL_ERROR "${INPUT}: bad time '${text}'")
    endif()
    set(int "${CMAKE_MATCH_1}")
    string(SUBSTRING "${CMAKE_MATCH_3}000000" 0 6 frac)
    string(REGEX REPLACE "^0+" "" int "${int}")
    string(REGEX REPLACE "^0+" "" frac "${frac}")
    math(EXPR v "0${int} * 1000000 + 0${frac}")
    set(${out} ${v} PARENT_SCOPE)
endfunction()

set(rate 22050)
file(STRINGS "${INPUT}" lines)
set(notes)
foreach(line IN LISTS lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line STREQUAL "")
        continue()
    endif()
    string(REGEX REPLACE "[ \t]+" ";" words "${line}")
    list(POP_FRONT words verb)
    if(verb STREQUAL "rate")
        list(GET words 0 rate)
    elseif(verb STREQUAL "partials")
        list(POP_FRONT words name)
        set(partials_${name} "${words}")
    elseif(verb STREQUAL "note")
        string(REPLACE ";" ":" note "${words}")
        list(APPEND notes "${note}")
    else()
        message(FATAL_ERROR "${INPUT}: unknown statement ${verb}")
    endif()
endforeach()

# the length of the sound: the end of the last note and 50 ms.
set(total 0)
foreach(note IN LISTS notes)
    string(REPLACE ":" ";" words "${note}")
    list(GET words 1 start)
    list(GET words 2 length)
    _wave_micros(start "${start}")
    _wave_micros(length "${length}")
    math(EXPR end "(${start} + ${length} + 50000) * ${rate} / 1000000")
    if(end GREATER total)
        set(total ${end})
    endif()
endforeach()

# samples are 1/65536 of full scale, in o_<index>.
math(EXPR nyquist "${rate} * 65536 * 10 / 22")
math(EXPR fade_out_samples "${rate} / 50")
foreach(note IN LISTS notes)
    string(REPLACE ":" ";" words "${note}")
    list(LENGTH words n)
    list(GET words 0 freq)
    list(GET words 1 start)
    list(GET words 2 length)
    list(GET words 3 gain)
    list(GET words 4 decay)
    list(GET words 5 timbre)
    set(attack 0.006)
    if(n GREATER 6)
        list(GET words 6 attack)
    endif()
    if(NOT DEFINED partials_${timbre})
        message(FATAL_ERROR "${INPUT}: no partials ${timbre}")
    endif()
    foreach(v freq gain decay)
        _rs_num(${v} "${${v}}")
    endforeach()
    foreach(v start length attack)
        _wave_micros(${v} "${${v}}")
    endforeach()
    math(EXPR first "${start} * ${rate} / 1000000")
    math(EXPR count "${length} * ${rate} / 1000000")
    math(EXPR attack_samples "${attack} * ${rate} / 1000000")
    if(attack_samples LESS 1)
        set(attack_samples 1)
    endif()
    # the oscillators: weight in 1/65536 of the note's gain over the sum of levels, cos of the step in 1/2^30.
    set(levels 0)
    set(pairs ${partials_${timbre}})
    set(oscillators)
    while(pairs)
        list(POP_FRONT pairs harmonic level)
        _rs_num(harmonic "${harmonic}")
        _rs_num(level "${level}")
        math(EXPR levels "${levels} + ${level}")
        math(EXPR hz "${freq} * ${harmonic} >> 16")
        if(hz LESS nyquist)
            math(EXPR w "${hz} * 2 * 3373259426 / ${rate} >> 16")
            _wave_sin(s ${w})
            math(EXPR cw "1686629713 - ${w}")
            _wave_sin(c ${cw})
            list(APPEND oscillators "${level}:${c}:${s}")
        endif()
    endwhile()
    set(k 0)
    set(sum "0")
    foreach(osc IN LISTS oscillators)
        string(REPLACE ":" ";" osc "${osc}")
        list(GET osc 0 level)
        list(GET osc 1 c${k})
        list(GET osc 2 s)
        math(EXPR weight${k} "${level} * ${gain} / ${levels}")
        set(y${k} 0)
        math(EXPR z${k} "-${s}")
        string(APPEND sum " + ${weight${k}} * (@y${k}@ >> 14)")
        math(EXPR k "${k} + 1")
    endforeach()
    if(k EQUAL 0)
        continue()
    endif()
    math(EXPR last "${k} - 1")
    # e^(-decay / rate) for each sample, in 1/2^30.
    math(EXPR x "${decay} * 16384 / ${rate}")
    math(EXPR step "1073741824 - ${x} + (${x} * ${x} >> 31) - ((${x} * ${x} >> 30) * ${x} / 6442450944)")
    set(env 1073741824)
    math(EXPR fade_from "${count} - ${fade_out_samples}")
    math(EXPR end "${count} - 1")
    foreach(i RANGE ${end})
        # the fades in 1/2^30.
        if(i LESS attack_samples)
            math(EXPR fade "${i} * 1073741824 / ${attack_samples}")
        else()
            set(fade 1073741824)
        endif()
        if(i GREATER fade_from)
            math(EXPR fade "(${fade} >> 15) * ((${count} - ${i}) * 32768 / ${fade_out_samples}) ")
        endif()
        string(CONFIGURE "${sum}" expression @ONLY)
        math(EXPR index "${first} + ${i}")
        math(EXPR o_${index} "0${o_${index}} + ((((${expression}) >> 16) * ((${env} >> 15) * (${fade} >> 15))) >> 30)")
        math(EXPR env "${env} * ${step} >> 30")
        foreach(j RANGE ${last})
            math(EXPR v "(2 * ${c${j}} * ${y${j}} >> 30) - ${z${j}}")
            set(z${j} ${y${j}})
            set(y${j} ${v})
        endforeach()
    endforeach()
endforeach()

# the peak, then 16 bit samples.
set(peak 0)
math(EXPR end "${total} - 1")
foreach(i RANGE ${end})
    set(v 0${o_${i}})
    if(v LESS 0)
        math(EXPR v "-${v}")
    endif()
    if(v GREATER peak)
        set(peak ${v})
    endif()
endforeach()
set(scale 65536)
if(peak GREATER 52428)
    math(EXPR scale "52428 * 65536 / ${peak}")
endif()
set(data "")
foreach(i RANGE ${end})
    math(EXPR v "(0${o_${i}} * ${scale} >> 16) * 32767")
    if(v LESS 0)
        math(EXPR v "-((-${v} + 32768) >> 16)")
    else()
        math(EXPR v "(${v} + 32768) >> 16")
    endif()
    if(v GREATER 32767)
        set(v 32767)
    elseif(v LESS -32767)
        set(v -32767)
    endif()
    math(EXPR lo "${v} & 255")
    math(EXPR hi "(${v} >> 8) & 255")
    string(APPEND data "${_mime_h2_${lo}}${_mime_h2_${hi}}")
endforeach()
math(EXPR bytes "${total} * 2")
math(EXPR riff "36 + ${bytes}")
math(EXPR byte_rate "${rate} * 2")
mime_le(a ${riff} 4)
mime_le(r ${rate} 4)
mime_le(b ${byte_rate} 4)
mime_le(d ${bytes} 4)
mime_hex_text(riff_tag "RIFF")
mime_hex_text(wave_tag "WAVEfmt ")
mime_hex_text(data_tag "data")
mime_write_binary("${OUTPUT}" "${riff_tag}${a}${wave_tag}1000000001000100${r}${b}02001000${data_tag}${d}${data}")
