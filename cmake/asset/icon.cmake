# Builds a resource file of Windows from the SVG drawings of the icons repository, run with cmake -P:
#   -DKIND=ico|cur|ani|bmp -DOUTPUT=<file> -DIMAGES=<svg>[@size];...
# An image without a size is drawn at the size the drawing declares. A cursor takes its hot spot from the
# data-hotspot attribute of the drawing, on the grid of its view box. An animated cursor takes cursor files as its
# frames, shown for the data-jiffies sixtieths of a second of the drawing JIFFIES_FROM. A bitmap is one bit deep, dark
# pixels black.
include(${CMAKE_CURRENT_LIST_DIR}/raster.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/png.cmake)

function(_icon_attr out svg name default)
    string(REGEX MATCH "<svg[^>]*>" root "${svg}")
    if(root MATCHES "[ \t\n]${name}=\"([^\"]*)\"")
        set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    else()
        set(${out} "${default}" PARENT_SCOPE)
    endif()
endfunction()

function(_icon_native out svg)
    _icon_attr(w "${svg}" width "")
    if(w STREQUAL "")
        _icon_attr(view "${svg}" viewBox "0 0 32 32")
        string(REGEX MATCHALL "[-+]?[0-9]*\\.?[0-9]+" view "${view}")
        list(GET view 2 w)
    endif()
    string(REGEX REPLACE "\\..*$" "" w "${w}")
    set(${out} ${w} PARENT_SCOPE)
endfunction()

# The PNG of a drawing at a size.
function(_icon_png out path size)
    file(READ "${path}" svg)
    if(size STREQUAL "")
        _icon_native(size "${svg}")
    endif()
    mime_svg_render(rows "${svg}" ${size})
    mime_png(png rows ${size} ${size})
    set(${out} "${png}" PARENT_SCOPE)
    set(${out}_size ${size} PARENT_SCOPE)
endfunction()

# An icon or cursor file from images, each a path and a size, smallest first as Windows keeps them.
function(_icon_file out kind images)
    set(entries)
    foreach(image IN LISTS images)
        string(REPLACE "@" ";" parts "${image}")
        list(GET parts 0 path)
        set(size "")
        list(LENGTH parts n)
        if(n GREATER 1)
            list(GET parts 1 size)
        endif()
        file(READ "${path}" svg)
        if(size STREQUAL "")
            _icon_native(size "${svg}")
        endif()
        math(EXPR key "100000 + ${size}")
        list(APPEND entries "${key}@${path}")
    endforeach()
    list(SORT entries COMPARE NATURAL)
    list(LENGTH entries count)
    if(kind STREQUAL "cur")
        set(type 2)
    else()
        set(type 1)
    endif()
    mime_le(head 0 2)
    mime_le(t ${type} 2)
    mime_le(c ${count} 2)
    set(directory "${head}${t}${c}")
    math(EXPR offset "6 + 16 * ${count}")
    set(blob "")
    foreach(entry IN LISTS entries)
        string(REPLACE "@" ";" parts "${entry}")
        list(GET parts 0 key)
        list(GET parts 1 path)
        math(EXPR size "${key} - 100000")
        _icon_png(png "${path}" ${size})
        mime_hex_length(bytes "${png}")
        math(EXPR dim "${size} % 256")
        mime_le(d ${dim} 1)
        if(kind STREQUAL "cur")
            file(READ "${path}" svg)
            _icon_attr(hot "${svg}" data-hotspot "0 0")
            _icon_attr(view "${svg}" viewBox "0 0 32 32")
            string(REGEX MATCHALL "[-+]?[0-9]*\\.?[0-9]+" view "${view}")
            list(GET view 2 grid)
            string(REGEX MATCHALL "[0-9]+" hot "${hot}")
            list(GET hot 0 hx)
            list(GET hot 1 hy)
            math(EXPR hx "${hx} * ${size} / ${grid}")
            math(EXPR hy "${hy} * ${size} / ${grid}")
            mime_le(p ${hx} 2)
            mime_le(b ${hy} 2)
        else()
            mime_le(p 1 2)
            mime_le(b 32 2)
        endif()
        mime_le(n ${bytes} 4)
        mime_le(o ${offset} 4)
        string(APPEND directory "${d}${d}0000${p}${b}${n}${o}")
        string(APPEND blob "${png}")
        math(EXPR offset "${offset} + ${bytes}")
    endforeach()
    set(${out} "${directory}${blob}" PARENT_SCOPE)
endfunction()

function(_icon_chunk out tag data)
    string(HEX "${tag}" tag)
    mime_hex_length(n "${data}")
    mime_le(size ${n} 4)
    math(EXPR odd "${n} % 2")
    if(odd)
        string(APPEND data "00")
    endif()
    set(${out} "${tag}${size}${data}" PARENT_SCOPE)
endfunction()

function(_icon_bitmap out path)
    file(READ "${path}" svg)
    _icon_native(w "${svg}")
    _icon_attr(h "${svg}" height ${w})
    mime_svg_render(rows "${svg}" ${w} ${h})
    math(EXPR stride "(${w} + 31) / 32 * 4")
    math(EXPR image "${stride} * ${h}")
    math(EXPR file_size "62 + ${image}")
    mime_le(a ${file_size} 4)
    set(hex "424d${a}000000003e000000")
    foreach(v 40 ${w} ${h})
        mime_le(a ${v} 4)
        string(APPEND hex "${a}")
    endforeach()
    mime_le(a ${image} 4)
    string(APPEND hex "0100010000000000${a}130b0000130b00000200000000000000")
    string(APPEND hex "00000000ffffff00")
    math(EXPR last "${h} - 1")
    math(EXPR pad "${stride} * 8 - ${w}")
    foreach(y RANGE ${last} 0 -1)
        set(bits 0)
        set(count 0)
        set(row "")
        foreach(p IN LISTS rows_${y})
            # light pixels are white, the bit set.
            math(EXPR light "(((${p} >> 24) & 255) * 30 + ((${p} >> 16) & 255) * 59 + ((${p} >> 8) & 255) * 11) / 12800")
            math(EXPR bits "(${bits} << 1) | ${light}")
            math(EXPR count "${count} + 1")
            if(count EQUAL 8)
                mime_le(a ${bits} 1)
                string(APPEND row "${a}")
                set(bits 0)
                set(count 0)
            endif()
        endforeach()
        foreach(i RANGE 1 ${pad})
            if(pad EQUAL 0)
                break()
            endif()
            math(EXPR bits "${bits} << 1")
            math(EXPR count "${count} + 1")
            if(count EQUAL 8)
                mime_le(a ${bits} 1)
                string(APPEND row "${a}")
                set(bits 0)
                set(count 0)
            endif()
        endforeach()
        string(APPEND hex "${row}")
    endforeach()
    set(${out} "${hex}" PARENT_SCOPE)
endfunction()

if(KIND STREQUAL "ico" OR KIND STREQUAL "cur")
    _icon_file(hex ${KIND} "${IMAGES}")
elseif(KIND STREQUAL "ani")
    # the frames are cursor files, shown as long as the first drawing's data-jiffies says.
    set(frames "")
    set(count 0)
    foreach(cur IN LISTS IMAGES)
        mime_read_binary(data "${cur}")
        _icon_chunk(chunk icon "${data}")
        string(APPEND frames "${chunk}")
        math(EXPR count "${count} + 1")
    endforeach()
    file(READ "${JIFFIES_FROM}" svg)
    _icon_attr(jiffies "${svg}" data-jiffies 5)
    set(header "")
    foreach(v 36 ${count} ${count} 0 0 32 1 ${jiffies} 1)
        mime_le(a ${v} 4)
        string(APPEND header "${a}")
    endforeach()
    _icon_chunk(anih anih "${header}")
    string(HEX "fram" fram)
    _icon_chunk(list LIST "${fram}${frames}")
    string(HEX "ACON" acon)
    _icon_chunk(hex RIFF "${acon}${anih}${list}")
elseif(KIND STREQUAL "bmp")
    _icon_bitmap(hex "${IMAGES}")
else()
    message(FATAL_ERROR "icon.cmake: KIND ${KIND}")
endif()
mime_write_binary("${OUTPUT}" "${hex}")
